[sub_resource type="Resource" id="Resource_mhxo7"]
script = ExtResource("2_ajq7y")
kind = 1
key = &"midsummer_hill"

[sub_resource type="Resource" id="Resource_re5c2"]
script = ExtResource("2_ajq7y")
text = "A fire burned on the hill all night, and everyone watched it from their doors."

[sub_resource type="Resource" id="Resource_xiwnm"]
script = ExtResource("1_e5jlc")
id = &"fire_on_the_hill"
label = "Light a fire on the hill and watch it from the huts"
effects = Array[ExtResource("2_ajq7y")]([SubResource("Resource_mhxo7"), SubResource("Resource_re5c2")])

[sub_resource type="Resource" id="Resource_fh0a1"]
script = ExtResource("2_ajq7y")
kind = 1
key = &"midsummer_hearth"

[sub_resource type="Resource" id="Resource_6gq3a"]
script = ExtResource("2_ajq7y")
text = "The whole village sat up round the hearth, and the sun came back before anyone slept."

[sub_resource type="Resource" id="Resource_so7me"]
script = ExtResource("1_e5jlc")
id = &"dance_round_the_hearth"
label = "Sit up round the village hearth until it is light again"
effects = Array[ExtResource("2_ajq7y")]([SubResource("Resource_fh0a1"), SubResource("Resource_6gq3a")])

