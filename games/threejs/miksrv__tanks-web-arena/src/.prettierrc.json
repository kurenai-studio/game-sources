{
  "printWidth": 120,
  "useTabs": true,
  "tabWidth": 4,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.json", "*.md", "*.yml", "*.yaml"],
      "options": { "useTabs": false, "tabWidth": 2 }
    }
  ]
}
