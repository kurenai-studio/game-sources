[project]
title = Defold Fighter
version = 0.1

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[input]
game_binding = /input/game.input_bindingc
gamepads = /builtins/input/default.gamepadsc

[display]
width = 1280
height = 720
high_dpi = 0
vsync = 1

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[script]
shared_state = 1

[render]
clear_color_red = 0.08
clear_color_green = 0.05
clear_color_blue = 0.1
clear_color_alpha = 1

[sprite]
max_count = 256

[collection_proxy]
max_count = 4

[physics]
max_collision_object_count = 0

[library]
include_dirs =

[fighter]
autoplay = 0
hitboxes = 0
