key = &"pressed_marks"

[sub_resource type="Resource" id="Resource_vvvs5"]
script = ExtResource("2_ay1pe")
text = "Every pot got its mark pressed into the clay before it was fired, and some of the marks looked remarkably like faces."

[sub_resource type="Resource" id="Resource_xh8fu"]
script = ExtResource("1_i8pdi")
id = &"press_the_mark"
