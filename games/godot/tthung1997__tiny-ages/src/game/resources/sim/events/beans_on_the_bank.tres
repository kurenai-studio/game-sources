[sub_resource type="Resource" id="Resource_nwtdq"]
script = ExtResource("2_tcxvp")
kind = 1
key = &"bank_beans"

[sub_resource type="Resource" id="Resource_pj22y"]
script = ExtResource("2_tcxvp")
text = "The bank was planted with beans, and in July it was a green wall, and in September it was dinner."

[sub_resource type="Resource" id="Resource_hriwd"]
script = ExtResource("1_oea1b")
id = &"plant_the_bank_with_beans"
label = "Plant the bank with beans"
effects = Array[ExtResource("2_tcxvp")]([SubResource("Resource_fcaun"), SubResource("Resource_nwtdq"), SubResource("Resource_pj22y")])

[sub_resource type="Resource" id="Resource_ta6el"]
script = ExtResource("2_tcxvp")
kind = 1
key = &"bank_grass"

[sub_resource type="Resource" id="Resource_iaqj2"]
script = ExtResource("2_tcxvp")
text = "The bank was left to the grass, which came up thick and green and was visited by every cricket in the valley."

[sub_resource type="Resource" id="Resource_cc2jv"]
script = ExtResource("1_oea1b")
id = &"leave_it_to_the_grass"
label = "Leave it to the grass"
effects = Array[ExtResource("2_tcxvp")]([SubResource("Resource_ta6el"), SubResource("Resource_iaqj2")])

