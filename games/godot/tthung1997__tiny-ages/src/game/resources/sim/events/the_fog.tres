[sub_resource type="Resource" id="Resource_qallv"]
script = ExtResource("2_rq70c")
kind = 1
key = &"fog_gong"

[sub_resource type="Resource" id="Resource_hvqxy"]
script = ExtResource("2_rq70c")
text = "A flat stone was hung from a post and struck on the hour, and the fog gave the sound back from every side."

[sub_resource type="Resource" id="Resource_5cxsl"]
script = ExtResource("1_64e3y")
id = &"strike_a_gong"
label = "Hang a flat stone and strike it every hour"
effects = Array[ExtResource("2_rq70c")]([SubResource("Resource_qallv"), SubResource("Resource_hvqxy")])

[sub_resource type="Resource" id="Resource_25aus"]
script = ExtResource("2_rq70c")
kind = 1
key = &"fog_rope"

[sub_resource type="Resource" id="Resource_owiep"]
script = ExtResource("2_rq70c")
text = "A rope ran from door to door, and everyone learned to walk with a hand on it."

[sub_resource type="Resource" id="Resource_1x48n"]
script = ExtResource("1_64e3y")
id = &"run_a_rope"
label = "Run a rope from hut to hut"
effects = Array[ExtResource("2_rq70c")]([SubResource("Resource_25aus"), SubResource("Resource_owiep")])

