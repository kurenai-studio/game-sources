; HotDog Sports Day — Godot project configuration.
; See README.md for the design this layout serves.

config_version=5

[application]

config/name="HotDog Sports Day"
config/description="International track and field for bouncing hot dogs: tap on the beat to bounce, hold and let go to jump."
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/app/icon.png"
boot_splash/bg_color=Color(0.03, 0.03, 0.04, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Profile="*res://game/profile.gd"
Sound="*res://ui/sound.gd"
Remote="*res://ui/remote.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/small.fnt"
theme/default_font_antialiasing=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.141, 0.082, 0.18, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
