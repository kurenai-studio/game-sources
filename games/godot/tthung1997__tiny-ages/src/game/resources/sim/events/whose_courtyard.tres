key = &"courtyard_open"

[sub_resource type="Resource" id="Resource_3a1ji"]
script = ExtResource("2_vaqbh")
text = "The courtyard was kept open to the sky, and the children were let in at once, and the weavers took their looms out on bright days and said it was an improvement."

[sub_resource type="Resource" id="Resource_13xym"]
