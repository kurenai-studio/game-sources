root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript is tab-indented by convention and the Godot editor enforces it.
[*.gd]
indent_style = tab
indent_size = 4

[*.{tscn,tres,godot,import,cfg}]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = false

[*.{md,yml,yaml,json,js,py}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
