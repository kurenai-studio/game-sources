key = &"stone_weights"

[sub_resource type="Resource" id="Resource_npbpn"]
script = ExtResource("2_bkcjj")
text = "A set of river stones was picked out, one for each size of argument, and the arguments, to everyone's surprise, got smaller."

[sub_resource type="Resource" id="Resource_pt1di"]
