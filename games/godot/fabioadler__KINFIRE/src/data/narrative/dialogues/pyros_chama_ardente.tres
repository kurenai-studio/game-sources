[gd_resource type="Resource" script_class="DialogueData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/data/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_ancient"]
script = ExtResource("3_choice")
text = "Você é a chama mais antiga?"
next_id = &"ancient_hint"
effects = "guardiao_knowledge +1"

[sub_resource type="Resource" id="Choice_prox"]
script = ExtResource("3_choice")
text = "E agora?"
next_id = &"goodbye"

[sub_resource type="Resource" id="Node_intro"]
script = ExtResource("2_node")
id = &"intro"
pages = PackedStringArray("FOGO! Sim, sou Pyros. Minha chama nunca se apagou.", "Guardião do Vulcão Escarlate. E a primeira chama que Maldrach viu nascer.")
choices = Array[ExtResource("3_choice")]([SubResource("Choice_ancient"), SubResource("Choice_prox")])

[sub_resource type="Resource" id="Node_ancient_hint"]
script = ExtResource("2_node")
id = &"ancient_hint"
pages = PackedStringArray("Sim. Quando Kinfire foi criada, fui eu quem primeiro ardia. O Cinzento — Ithariel — cuidou de mim quando a Primeira Chama ainda queimava verdade.", "Agora o fogo é seu. Cuide bem.")
choices = Array[ExtResource("3_choice")]([SubResource("Choice_prox")])

[sub_resource type="Resource" id="Node_fragment"]
script = ExtResource("2_node")
id = &"fragment"
pages = PackedStringArray("Este Fragmento é a chama mais antiga. A que o Cinzento viu nascer. Leve-o ao coração — ali é onde deve arder.")
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Node_goodbye"]
script = ExtResource("2_node")
id = &"goodbye"
pages = PackedStringArray("Sete guardiões reunidos. Agora, o oitavo arde em cinzas. Encontre-o. Encontre Kinfire. Apague a mentira.")
choices = Array[ExtResource("3_choice")]([])

[resource]
script = ExtResource("1_script")
id = &"pyros_chama_ardente"
display_name = "Pyros"
portrait = "barbarian_m"
start_id = &"intro"
nodes = Array[ExtResource("2_node")]([SubResource("Node_intro"), SubResource("Node_ancient_hint"), SubResource("Node_fragment"), SubResource("Node_goodbye")])
