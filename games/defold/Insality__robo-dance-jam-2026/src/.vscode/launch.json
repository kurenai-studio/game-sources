	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Lua Interpreter",
			"type": "lua-local",
			"request": "launch",
			"program": {
				"lua": "lua",
				"file": "${file}"
			}
		},
		{
			"name": "Debug Custom Lua Environment",
			"type": "lua-local",
			"request": "launch",
			"program": {
				"command": "command"
			},
			"args": []
		},
		{
			"name": "Defold Kit",
			"type": "lua-local",
			"request": "launch",
			"stopOnEntry": false,
			"verbose": false,
			"internalConsoleOptions": "openOnSessionStart",
			"program": {
				"command": "build/defoldkit/dmengine"
			},
			"args": [
				"build/defoldkit/game.projectc"
			],
			"windows": {
				"program": {
					"command": "build\\defoldkit\\dmengine.exe"
				},
				"args": [
					"build\\defoldkit\\game.projectc"
				]
			},
			"preLaunchTask": "Defold Kit: Build to Launch"
		}
	]
}
