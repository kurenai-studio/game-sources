label = "Make a bellows from a hide bag and a clay pipe"
effects = Array[ExtResource("2_rfgcu")]([SubResource("Resource_bfp3y"), SubResource("Resource_wlclv")])

[sub_resource type="Resource" id="Resource_bsao2"]
