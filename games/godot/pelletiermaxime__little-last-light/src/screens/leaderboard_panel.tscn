[gd_scene format=3]

[ext_resource type="Theme" path="res://game_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://screens/leaderboard_panel.gd" id="2_script"]

[node name="LeaderboardPanel" type="VBoxContainer"]
script = ExtResource("2_script")
theme = ExtResource("1_theme")
theme_override_constants/separation = 8

[node name="Tabs" type="HBoxContainer" parent="."]
layout_mode = 2
visible = false

[node name="RankingsButton" type="Button" parent="Tabs"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Rankings"

[node name="SubmissionButton" type="Button" parent="Tabs"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Publish record"

[node name="Submission" type="VBoxContainer" parent="."]
layout_mode = 2
visible = false
theme_override_constants/separation = 8

[node name="Prompt" type="Label" parent="Submission"]
layout_mode = 2
mouse_filter = 2
text = "Publish your personal best?"
autowrap_mode = 3

[node name="Username" type="LineEdit" parent="Submission"]
layout_mode = 2
placeholder_text = "Username (3–20 letters, numbers, _)"
max_length = 20
accessibility_name = "Leaderboard username"

[node name="PublishButton" type="Button" parent="Submission"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Publish my record"

[node name="SkipButton" type="Button" parent="Submission"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "No thanks"

[node name="Rankings" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Rankings"]
layout_mode = 2
mouse_filter = 2
text = "LEADERBOARD"
autowrap_mode = 3
theme_type_variation = &"AccentLabel"

[node name="Notice" type="Label" parent="Rankings"]
layout_mode = 2
mouse_filter = 2
text = "Loading scores…"
autowrap_mode = 3

[node name="ScoresPage" type="VBoxContainer" parent="Rankings"]
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Rankings/ScoresPage"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Pager" type="HBoxContainer" parent="Rankings"]
layout_mode = 2
visible = false

[node name="PreviousButton" type="Button" parent="Rankings/Pager"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Previous"

[node name="PageLabel" type="Label" parent="Rankings/Pager"]
layout_mode = 2
mouse_filter = 2
text = "1 / 1"
autowrap_mode = 3
vertical_alignment = 1

[node name="NextButton" type="Button" parent="Rankings/Pager"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Next"

[node name="RefreshButton" type="Button" parent="Rankings"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Refresh leaderboard"

[node name="AllVersions" type="LinkButton" parent="Rankings"]
layout_mode = 2
focus_mode = 2
text = "All versions online"

[node name="Notice" type="Label" parent="."]
layout_mode = 2
mouse_filter = 2
text = ""
autowrap_mode = 3

[node name="ScoresRequest" type="HTTPRequest" parent="."]
timeout = 15

[node name="PublishRequest" type="HTTPRequest" parent="."]
timeout = 15
body_size_limit = 8192
