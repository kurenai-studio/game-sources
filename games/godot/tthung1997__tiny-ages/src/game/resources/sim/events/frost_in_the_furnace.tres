[sub_resource type="Resource" id="Resource_ubhs8"]
script = ExtResource("2_lf4g5")
kind = 1
key = &"furnace_kept_lit"

[sub_resource type="Resource" id="Resource_s4kh2"]
script = ExtResource("2_lf4g5")
text = "The furnace was kept lit all winter, fed a little at a time, and was the warmest place in the village and, for that reason, the busiest."

[sub_resource type="Resource" id="Resource_jpy05"]
script = ExtResource("3_xxjj2")
kind = 2
key = &"wood"
amount = 10

[sub_resource type="Resource" id="Resource_vwp4n"]
script = ExtResource("1_ua1bj")
id = &"keep_it_lit_all_winter"
label = "Keep it lit all winter"
requires = Array[ExtResource("3_xxjj2")]([SubResource("Resource_jpy05")])
effects = Array[ExtResource("2_lf4g5")]([SubResource("Resource_l8rhh"), SubResource("Resource_ubhs8"), SubResource("Resource_s4kh2")])

[sub_resource type="Resource" id="Resource_n7ket"]
script = ExtResource("2_lf4g5")
kind = 1
key = &"furnace_banked"

[sub_resource type="Resource" id="Resource_0llt3"]
script = ExtResource("2_lf4g5")
text = "The furnace was banked under clay and straw, and sat all winter like a sleeping animal, and woke up grumpy in the spring."

[sub_resource type="Resource" id="Resource_c0p50"]
script = ExtResource("1_ua1bj")
id = &"bank_it_and_wait"
label = "Bank it, and wait for the spring"
effects = Array[ExtResource("2_lf4g5")]([SubResource("Resource_n7ket"), SubResource("Resource_0llt3")])

