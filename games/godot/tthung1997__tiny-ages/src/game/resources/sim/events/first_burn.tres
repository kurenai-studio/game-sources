key = &"bloom_blown"

[sub_resource type="Resource" id="Resource_3cdj2"]
script = ExtResource("2_yiaax")
kind = 10
key = &"first_bloom"
text = "The First Bloom"

[sub_resource type="Resource" id="Resource_yp2js"]
script = ExtResource("2_yiaax")
text = "The bellows were worked in turns until dawn. When the furnace was broken open there was a bloom in it, glowing, ugly and exactly what was wanted."

[sub_resource type="Resource" id="Resource_kcwdp"]
script = ExtResource("1_rm6qa")
id = &"blow_all_night"
label = "Work the bellows all night, in turns"
effects = Array[ExtResource("2_yiaax")]([SubResource("Resource_bssga"), SubResource("Resource_3cdj2"), SubResource("Resource_yp2js")])

[sub_resource type="Resource" id="Resource_4f7at"]
script = ExtResource("2_yiaax")
