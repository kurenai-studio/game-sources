.godot/
AGENTS.md
*.tmp
.tmp_*.log
tests/out/

# артефакты экспорта: godot --export пишет их в корень проекта, в git им не место
Car Crash Simulator.*

# пресеты экспорта локальные: у каждой машины свои пути сборки и свои подписи.
# Файл уже лежит в истории (e395c45) — с плейсхолдерами вместо секретов, но
# повторного add -A допускать не надо.
export_presets.cfg
# Переносимые пресеты инструментов — часть репозитория.
!tools/export_presets.cfg

# изолированный user://, в котором крутятся тесты (см. APPDATA в командах запуска)
tests/tmpappdata/

# Логи, JSON-отчёты и переносимые desktop-сборки.
/artifacts/

# Шаблоны экспорта (.tpz) — скачанный архив движка, весит гигабайт; в истории
# ему не место даже в проекте, если он попал внутрь репозитория, а не в AppData.
*.tpz
