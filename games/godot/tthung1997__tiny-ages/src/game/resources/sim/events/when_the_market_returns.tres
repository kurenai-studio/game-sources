amount = 340

[sub_resource type="Resource" id="Resource_cqh4p"]
script = ExtResource("3_w0175")
kind = 9
key = &"the_square"

[resource]
script = ExtResource("4_anvpd")
id = &"when_the_market_returns"
title = "When the market returns"
body = "The markets of the other towns come round on a rota, and the town's own comes round on its own, and someone has asked how the rota should be shared."
category = &"settlement"
requires = Array[ExtResource("3_w0175")]([SubResource("Resource_cvehd"), SubResource("Resource_bd616"), SubResource("Resource_cqh4p")])
chance_per_tick = 0.05
once = true
choices = Array[ExtResource("1_mgxpu")]([SubResource("Resource_ld55k"), SubResource("Resource_stfvm")])
