[sub_resource type="Resource" id="Resource_oeg60"]
script = ExtResource("2_uifsa")
kind = 1
key = &"hide_floor"

[sub_resource type="Resource" id="Resource_e8vh0"]
script = ExtResource("2_uifsa")
text = "The hides went down in rows, and the cave smelled of animals and was a good deal warmer."

[sub_resource type="Resource" id="Resource_i0j6w"]
script = ExtResource("1_37v1s")
id = &"hang_hides"
label = "Spread the spare hides over the floor"
effects = Array[ExtResource("2_uifsa")]([SubResource("Resource_oeg60"), SubResource("Resource_e8vh0")])

[sub_resource type="Resource" id="Resource_ovd0c"]
script = ExtResource("2_uifsa")
kind = 1
key = &"reed_beds"

[sub_resource type="Resource" id="Resource_i1y8r"]
script = ExtResource("2_uifsa")
text = "Armfuls of reeds were carried up from the river, and everyone slept on a rustling bed."

[sub_resource type="Resource" id="Resource_vj0k5"]
script = ExtResource("1_37v1s")
id = &"cut_reeds"
label = "Cut reeds from the river for bedding"
effects = Array[ExtResource("2_uifsa")]([SubResource("Resource_ovd0c"), SubResource("Resource_i1y8r")])

[sub_resource type="Resource" id="Resource_uyi7g"]
