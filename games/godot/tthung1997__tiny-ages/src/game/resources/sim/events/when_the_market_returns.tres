[sub_resource type="Resource" id="Resource_1gf3g"]
script = ExtResource("2_36moj")
kind = 1
key = &"market_charter"

[sub_resource type="Resource" id="Resource_woi38"]
script = ExtResource("2_36moj")
text = "The rota was written into a charter, and signed by all the towns, and the market days fell into a kind of music."

[sub_resource type="Resource" id="Resource_ld55k"]
script = ExtResource("1_mgxpu")
id = &"a_shared_charter"
label = "Write the rota into a charter the towns share"
effects = Array[ExtResource("2_36moj")]([SubResource("Resource_1gf3g"), SubResource("Resource_woi38")])

[sub_resource type="Resource" id="Resource_3ks2l"]
script = ExtResource("2_36moj")
kind = 1
key = &"market_hospitality"

[sub_resource type="Resource" id="Resource_g1d4v"]
script = ExtResource("2_36moj")
text = "Each market was met with a meal, and the visitors stayed as friends, and the rota was kept by custom and kindness."

[sub_resource type="Resource" id="Resource_stfvm"]
script = ExtResource("1_mgxpu")
id = &"hospitality_on_the_round"
label = "Host each market with a meal, and stay as friends"
effects = Array[ExtResource("2_36moj")]([SubResource("Resource_3ks2l"), SubResource("Resource_g1d4v")])

[sub_resource type="Resource" id="Resource_cvehd"]
script = ExtResource("3_w0175")
