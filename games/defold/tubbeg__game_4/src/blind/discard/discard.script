function on_message(self, message_id, message, sender)
	if message_id == hash("discard_card") then
		table.insert(self.discarded_cards, message.card)
		local pos = go.get_position()
		pos.z = -1
		go.animate(message.card, "position", go.PLAYBACK_ONCE_FORWARD, pos, go.EASING_LINEAR, 0.3, 0)
		msg.post("hand", "draw_one_card")
	end
end

