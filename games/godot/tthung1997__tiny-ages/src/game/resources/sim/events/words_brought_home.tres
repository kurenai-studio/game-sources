key = &"words_written"

[sub_resource type="Resource" id="Resource_4sxrd"]
script = ExtResource("2_ag3u2")
text = "The new words were written down, with what they meant, and the town's word-list grew by a page, and then, in an unfortunate week, by three."

[sub_resource type="Resource" id="Resource_308so"]
script = ExtResource("1_yh872")
id = &"write_the_words_down"
label = "Write them down, with what they mean"
effects = Array[ExtResource("2_ag3u2")]([SubResource("Resource_ia86f"), SubResource("Resource_4sxrd")])

[sub_resource type="Resource" id="Resource_7kgx6"]
script = ExtResource("2_ag3u2")
kind = 1
key = &"words_spread"

[sub_resource type="Resource" id="Resource_oblv8"]
script = ExtResource("2_ag3u2")
text = "The new words were let spread by use, and some stayed, and some did not, and the ones that stayed turned out to be the rude ones."

[sub_resource type="Resource" id="Resource_1de4i"]
script = ExtResource("1_yh872")
id = &"let_them_spread"
label = "Let them spread by use, and see which stay"
effects = Array[ExtResource("2_ag3u2")]([SubResource("Resource_7kgx6"), SubResource("Resource_oblv8")])

