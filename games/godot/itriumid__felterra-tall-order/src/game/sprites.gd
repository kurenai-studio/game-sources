....kook........kOOk........
"""
const JOGI_FEET := Vector2(12, 19)


## A frame of Jogiboy's walk: his own upper body, on the dogs' legs, ginger above and white below.
static func jogi_art(frame: int) -> String:
	var legs := (DOG_LEGS[frame % 4] as String).strip_edges().split("\n")
	for y in legs.size():
		legs[y] = legs[y].replace("n", "O" if y < 2 else "W")
	return JOGI_UPPER.strip_edges() + "\n" + "\n".join(legs)


static func dog_art(frame: int) -> String:
	return DOG_UPPER.strip_edges() + "\n" + (DOG_LEGS[frame % 4] as String).strip_edges()

static var _cache := {}
static var _held := {}


## Every piece of art here, by name, so a test can check them all against the palette.
static func all_art() -> Dictionary:
	var art := {"caping": CAPING, "hard_hat": HARD_HAT, "peci": PECI}
	for name: String in BODIES:
		for view: String in BODIES[name]:
			art["%s_%s" % [name, view]] = BODIES[name][view]
	for name: String in WORN:
		for view: String in WORN[name]:
			art["%s_%s" % [name, view]] = WORN[name][view]
	for view: String in CAT_UPPER:
		for frame in 4:
			art["cat_%s_%d" % [view, frame]] = cat_body_art(view, frame)
		art["vest_" + view] = VESTS[view]
	var held := held_art()
	for weapon: String in held:
		for direction: String in held[weapon]:
			art["%s_%s" % [weapon, direction]] = held[weapon][direction].art
	for index in RAT_STRIDES.size():
		art["rat_%d" % index] = RAT_STRIDES[index]
	for frame in 4:
		art["dog_%d" % frame] = dog_art(frame)
	for mutation: String in MUTATION_ART:
		art["mutation_" + mutation] = MUTATION_ART[mutation]
	for frame in DRONE_FRAMES.size():
		art["drone_%d" % frame] = DRONE_FRAMES[frame]
	art["drone_docked"] = DRONE_DOCKED
	art["kite"] = KITE
	for frame in RAT_BARON.size():
		art["rat_baron_%d" % frame] = RAT_BARON[frame]
	for structure: String in STRUCTURES:
		art["structure_" + structure] = STRUCTURES[structure]
	art["radio"] = RADIO
	art["bee_hive"] = BEE_HIVE
	for frame in 4:
		art["jogi_%d" % frame] = jogi_art(frame)
	for who: String in Portraits.CAST.keys() + ["jogiboy"]:
		for mood in Portraits.MOODS:
			art["portrait_%s_%s" % [who, mood]] = Portraits.art(who, mood)
	art["alarm_drum"] = ALARM_DRUM
	art["snare"] = SNARE
	art["spikes"] = SPIKES
	for index in SALVAGE.size():
		art["salvage_%d" % index] = SALVAGE[index]
	for coat_name: String in COATS:
		art["cat_coat_" + coat_name] = coat(cat_body_art("side", 0), coat_name, "side")
	art["meriam_bambu"] = MERIAM_BAMBU
	art["mine"] = MINE
	art["mine_arming"] = MINE_ARMING
	for layers: Dictionary in [PACK, MOUNTS.meriam_bambu, MOUNTS.mines]:
		for view: String in layers:
			for depth: String in layers[view]:
				art["pack_%d_%s_%s" % [art.size(), view, depth]] = layers[view][depth]
	return art



