-- Astro Drift — Defold player script
-- Attach to the `player.go` game object. Reads input bound in
-- `input/game.input_binding` and drives an inertial drifting ship.

local THRUST = 350
local ROT_SPEED = 4
local DRAG_PER_SEC = 0.55
local MAX_SPEED = 480
local SHOOT_COOLDOWN = 0.18

local W, H = 960, 540

function init(self)
	self.vel = vmath.vector3()
	self.heading = 0
	self.left = false
	self.right = false
	self.thrust = false
	self.fire = false
	self.cooldown = 0
	msg.post(".", "acquire_input_focus")
end

local function wrap(p, w, h)
	if p.x < 0 then p.x = p.x + w end
	if p.x > w then p.x = p.x - w end
	if p.y < 0 then p.y = p.y + h end
	if p.y > h then p.y = p.y - h end
	return p
end

function update(self, dt)
	local rot_input = 0
	if self.left then rot_input = rot_input - 1 end
	if self.right then rot_input = rot_input + 1 end
	self.heading = self.heading + rot_input * ROT_SPEED * dt

	if self.thrust then
		self.vel.x = self.vel.x + math.cos(self.heading - math.pi / 2) * THRUST * dt
		self.vel.y = self.vel.y + math.sin(self.heading - math.pi / 2) * THRUST * dt
	end

	local damp = DRAG_PER_SEC ^ dt
	self.vel.x, self.vel.y = self.vel.x * damp, self.vel.y * damp
	local sp = math.sqrt(self.vel.x * self.vel.x + self.vel.y * self.vel.y)
	if sp > MAX_SPEED then
		self.vel.x, self.vel.y = self.vel.x / sp * MAX_SPEED, self.vel.y / sp * MAX_SPEED
	end

	local pos = go.get_position()
	pos = pos + self.vel * dt
	pos = wrap(pos, W, H)
	go.set_position(pos)
	go.set_rotation(vmath.quat_rotation_z(-self.heading))

	self.cooldown = self.cooldown - dt
	if self.fire and self.cooldown <= 0 then
		self.cooldown = SHOOT_COOLDOWN
		local dx = math.cos(self.heading - math.pi / 2)
		local dy = math.sin(self.heading - math.pi / 2)
		local spawn = vmath.vector3(pos.x + dx * 18, pos.y + dy * 18, 0)
		factory.create("/factories#bullet_factory", spawn, nil, { velocity = vmath.vector3(dx * 700, dy * 700, 0) })
	end
end

function on_input(self, action_id, action)
	if action_id == hash("left") then
		self.left = not action.released
	elseif action_id == hash("right") then
		self.right = not action.released
	elseif action_id == hash("thrust") then
		self.thrust = not action.released
	elseif action_id == hash("fire") then
		self.fire = not action.released
	end
end
