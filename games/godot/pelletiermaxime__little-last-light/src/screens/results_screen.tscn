[gd_scene format=3]

[ext_resource type="Theme" path="res://game_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://screens/results_screen.gd" id="2_script"]

[node name="ResultsScreen" type="CanvasLayer"]
script = ExtResource("2_script")

[node name="Overlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1
anchor_bottom = 1
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025, 0.04, 0.06, 0.94)
theme = ExtResource("1_theme")

[node name="Card" type="PanelContainer" parent="Overlay"]
theme_type_variation = &"DialogPanel"
offset_right = 500
offset_bottom = 350

[node name="Content" type="VBoxContainer" parent="Overlay/Card"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="SummaryPage" type="VBoxContainer" parent="Overlay/Card/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Overlay/Card/Content/SummaryPage"]
layout_mode = 2
mouse_filter = 2
text = "The light went out"
autowrap_mode = 3
theme_type_variation = &"SettingsTitle"

[node name="Stats" type="Label" parent="Overlay/Card/Content/SummaryPage"]
layout_mode = 2
mouse_filter = 2
text = "Survived 00:00\n+0 energy earned"
autowrap_mode = 3
theme_override_font_sizes/font_size = 24

[node name="Best" type="Label" parent="Overlay/Card/Content/SummaryPage"]
layout_mode = 2
mouse_filter = 2
text = "Best: 00:00 · 0 energy available"
autowrap_mode = 3
theme_type_variation = &"SettingsNote"

[node name="RecordsHost" type="VBoxContainer" parent="Overlay/Card/Content"]
layout_mode = 2
visible = false

[node name="SaveNotice" type="Label" parent="Overlay/Card/Content"]
layout_mode = 2
mouse_filter = 2
text = ""
autowrap_mode = 3
theme_type_variation = &"WarningLabel"
visible = false

[node name="PageButton" type="Button" parent="Overlay/Card/Content"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Leaderboard"

[node name="ContinueButton" type="Button" parent="Overlay/Card/Content"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Continue to preparation"
theme_type_variation = &"PrimaryButton"
