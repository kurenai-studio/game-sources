body = "The first heavy rain on the new paving made a river of the lane, which was paved, and so ran very fast."
category = &"nature"
requires = Array[ExtResource("3_4c80u")]([SubResource("Resource_cgbr0"), SubResource("Resource_arqeq"), SubResource("Resource_v8tx8")])
