; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Merge a nuke"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/image="res://assets/splash.png"
config/icon="res://assets/icon.png"

[autoload]

GameState="*res://scripts/game_state.gd"
Economy="*res://scripts/economy.gd"
AdService="*res://scripts/ad_service.gd"
SaveManager="*res://scripts/save_manager.gd"
RaidService="*res://scripts/raid_service.gd"
AudioManager="*res://scripts/audio_manager.gd"
IAPService="*res://scripts/iap_service.gd"
DailyRewardManager="*res://scripts/daily_reward_manager.gd"
MissionManager="*res://scripts/mission_manager.gd"
EventManager="*res://scripts/event_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/funplay_mcp/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
