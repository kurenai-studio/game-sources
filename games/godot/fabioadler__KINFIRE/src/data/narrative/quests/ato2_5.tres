[sub_resource type="Resource" id="Resource_7n2cm"]
script = ExtResource("3_0yevt")
description = "Tieflings e meio-orcs SÃO primos. Ambos nasceram de sangue de fora que o Véu rotulou de maldito. A diferença é só quem contou a história primeiro."
