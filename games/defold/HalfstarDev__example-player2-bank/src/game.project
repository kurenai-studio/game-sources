[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 540
high_dpi = 1
update_frequency = 60

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch
show_fullscreen_button = 0
show_made_with_defold = 0
show_console_banner = 0
splash_image = /assets/images/splash.jpg
cssfile = /builtins/manifests/web/dark_theme.css

[project]
title = My Bank Swapped All Its Tellers for Toasters, So Now I'm Robbing the Place!
custom_resources = data
dependencies#0 = https://github.com/subsoap/defos/archive/refs/tags/v2.8.3.zip

[input]
repeat_interval = 0.05

[library]
include_dirs = player2

[graphics]
opengl_version_hint = 0

[native_extension]
app_manifest = /main/main.appmanifest

[player2]
id = 01991a78-12b9-7136-995a-244aa7bffe23

