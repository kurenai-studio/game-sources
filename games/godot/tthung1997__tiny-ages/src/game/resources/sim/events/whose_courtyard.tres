[resource]
script = ExtResource("4_5hvrp")
id = &"whose_courtyard"
title = "Whose courtyard stays open"
body = "The paved courtyard between the houses has become the best place in town, and {subject} has noticed that the weavers want a roof over it, and the children do not."
requires = Array[ExtResource("3_5ysfn")]([SubResource("Resource_rpxpi"), SubResource("Resource_s5j6j"), SubResource("Resource_0dmtn")])
