[resource]
script = ExtResource("2_utrfv")
id = &"misterio_6"
title = "A Torre sem Portas"
summary = "Rumores de uma torre que aparece e some na borda dos territórios. Quem entra combate projeções dos SEUS medos — os Sete Sussurros conhecem você, jogador. Não o personagem."
act = 2
quest_level = 16
chain = &"misterio"
prerequisites = Array[StringName]([&"ato2_1"])
