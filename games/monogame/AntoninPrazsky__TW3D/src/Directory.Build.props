<Project>
  <!-- Settings shared by all projects in src/ -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- The original code was written without nullable annotations and implicit usings -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Authors>Antonín Pražský</Authors>
    <Product>Triple Wheel 3D</Product>
    <Copyright>Copyright © Antonín Pražský 2014–2026</Copyright>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!--
    Game content (content/): the content pipeline (Content.mgcb) builds the models, shaders and images from their sources,
    the other files (precompiled fonts, levels, the catalog) are copied as they are.
    ContentPipelineSources lists the files not to copy: the sources and the pipeline's build folders.
  -->
  <PropertyGroup>
    <GameContentDir>$(MSBuildThisFileDirectory)content\</GameContentDir>
    <ContentPipelineSources>$(GameContentDir)Content.mgcb;$(GameContentDir)**\*.obj;$(GameContentDir)**\*.mtl;$(GameContentDir)**\*.fx;$(GameContentDir)**\*.png;$(GameContentDir)**\*.spritefont;$(GameContentDir)**\*.ttf;$(GameContentDir)bin\**;$(GameContentDir)obj\**</ContentPipelineSources>
  </PropertyGroup>
</Project>
