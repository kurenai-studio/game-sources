[resource]
script = ExtResource("4_4f73n")
id = &"newcomers_and_the_agreements"
title = "Newcomers and the agreements"
body = "New people keep arriving along the road, and the town's laws are not theirs, and someone has asked how long the old ones have to wait to be read."
