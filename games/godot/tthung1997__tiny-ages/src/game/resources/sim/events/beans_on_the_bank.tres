[resource]
script = ExtResource("4_g00gj")
id = &"beans_on_the_bank"
title = "Beans on the bank"
body = "The bank round the fort is bare earth, and somebody has pointed out that nothing grows on bare earth except resentment."
category = &"settlement"
requires = Array[ExtResource("3_yudrg")]([SubResource("Resource_loarx"), SubResource("Resource_8jwlh"), SubResource("Resource_ocn8y"), SubResource("Resource_kwpho")])
