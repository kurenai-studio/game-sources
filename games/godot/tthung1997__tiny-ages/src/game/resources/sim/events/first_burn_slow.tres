[sub_resource type="Resource" id="Resource_b2blv"]
script = ExtResource("2_1dsy5")
text = "The bellows were worked in turns until dawn. When the furnace was broken open there was a bloom in it, glowing, ugly and exactly what was wanted."

[sub_resource type="Resource" id="Resource_trnr6"]
script = ExtResource("1_v4wrx")
