[sub_resource type="Resource" id="Resource_c076w"]
script = ExtResource("3_yddpq")
description = "Vaelora chora quando você não a acusa. A Chama do Pântano acende violeta como aurora sobre água parada. O perdão de quem não sabia é a regra de todas as outras Chamas."
objectives = Array[ExtResource("4_bubrq")]([SubResource("Resource_refpy")])

[resource]
script = ExtResource("2_iqlct")
id = &"ato3_4"
title = "A Lágrima que Curou o Pântano"
summary = "Útero da Mãe: perdoar Vaelora. Ela entregou a relíquia sob o Véu — e não sabia. Não há combate. Há conversa — a mais difícil do mundo."
act = 3
quest_level = 19
stages = Array[ExtResource("3_yddpq")]([SubResource("Resource_eis0n"), SubResource("Resource_c076w")])
rewards = SubResource("Resource_pk0ou")
next = &"ato3_5"
