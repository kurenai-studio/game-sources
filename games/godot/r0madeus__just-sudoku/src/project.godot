; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Just Sudoku"
run/main_scene="res://scenes/app_root.tscn"
run/low_processor_mode=true
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.067, 0.078, 0.102, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

DevTools="*res://scripts/dev/dev_tools.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.067, 0.078, 0.102, 1)
