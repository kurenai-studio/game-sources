[layer_names]

3d_physics/layer_1="Mundo"
3d_physics/layer_2="Jogador"
3d_physics/layer_3="Perigos"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.05, 0.055, 0.1, 1)
