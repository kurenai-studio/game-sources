[sub_resource type="Resource" id="Resource_t2vna"]
script = ExtResource("2_gtgd8")
text = "A hearth was built beside the kiln, and the first thing it made was smoke, a great deal of it."

[sub_resource type="Resource" id="Resource_w180i"]
