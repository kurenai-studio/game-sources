[application]

config/name="Night Shift at Site-42"
config/description="3D PSX Retro First-Person Atmospheric Immersive Sim where you work graveyard maintenance in a facility whose modular rooms shift unless anchored by Polaroid photographs."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

