local druid = require("druid.druid")
local anim = require("menu.anim")

local function back_clicked(self)
	msg.post("main:/container", "load_menu")
	self.back_btn:set_enabled(false)
end

function init(self)
	self.druid = druid.new(self)
	self.back_btn = self.druid:new_button("back", back_clicked)
	self.back_btn:set_key_trigger(hash("pause"))
	local ver = gui.get_node("version")
	gui.set_text(ver, "v" .. sys.get_config("project.version"))
	anim.animate("title", anim.DEFAULT_D)
	anim.animate("version", anim.MEDIUM_D)
	anim.animate("jam", anim.SLOW_D)
	anim.animate("back", anim.MEDIUM_D)
	anim.animate("team", anim.MEDIUM_D)
	anim.animate("team1", anim.FAST_D)
	anim.animate("team2", anim.FAST_D)
	anim.animate("controls", anim.FAST_D)
	anim.animate("engine", anim.SLOW_D)
	anim.animate("best", anim.SLOW_D)
end

function final(self)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end