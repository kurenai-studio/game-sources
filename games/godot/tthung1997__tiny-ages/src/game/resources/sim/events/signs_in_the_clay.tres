[resource]
script = ExtResource("4_02je5")
id = &"signs_in_the_clay"
title = "A sign for a sound"
body = "The marks on the old clay slabs have begun to be used for the sounds in words, and nobody is sure who started it."
requires = Array[ExtResource("3_th42c")]([SubResource("Resource_fkcsq"), SubResource("Resource_vesmt"), SubResource("Resource_ddvsl"), SubResource("Resource_m6ri1"), SubResource("Resource_qt13h")])
