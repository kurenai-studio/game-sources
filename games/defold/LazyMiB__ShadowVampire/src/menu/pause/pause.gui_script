local druid = require("druid.druid")
local checkbox = require("menu.templates.checkbox")
local anim = require("menu.anim")
local state = require("main.state")
local music_const = require("game.music.music_const")

local INPUT_1 = hash("key_1")
local INPUT_2 = hash("key_2")

local function resume_clicked(self)
	msg.post("main:/container", "resume_game")
	self.resume_btn:set_enabled(false)
end

local function menu_clicked(self)
	msg.post("main:/container", "exit_game")
	self.menu_btn:set_enabled(false)
end

local function music_clicked(value)
	if value then
		sound.set_group_gain("music", music_const.MUSIC_GAIN)
	else
		sound.set_group_gain("music", 0)
	end
	state.set(state.key.MUSIC_ENABLED, value)
end

local function sounds_clicked(value)
	if value then
		sound.set_group_gain("sound", music_const.SOUND_GAIN)
	else
		sound.set_group_gain("sound", 0)
	end
	state.set(state.key.SOUND_ENABLED, value)
end

function init(self)
	self.druid = druid.new(self)
	self.resume_btn = self.druid:new_button("resume", resume_clicked)
	self.resume_btn:set_key_trigger(hash("pause"))
	self.menu_btn = self.druid:new_button("menu", menu_clicked)
	self.menu_btn:set_key_trigger(hash("down"))
	self.music_chbox = self.druid:new(checkbox, "music")
	self.music_chbox.on_state_changed:subscribe(music_clicked)
	self.music_chbox:set_state(state.get(state.key.MUSIC_ENABLED))
	self.sounds_chbox = self.druid:new(checkbox, "sounds")
	self.sounds_chbox.on_state_changed:subscribe(sounds_clicked)
	self.sounds_chbox:set_state(state.get(state.key.SOUND_ENABLED))
	gui.set_text(gui.get_node("lvl"), "Level: " .. state.get(state.key.LEVEL_CURRENT))
	anim.animate("blocker", anim.FAST_D)
	anim.animate("music/root", anim.MEDIUM_D)
	anim.animate("sounds/root", anim.MEDIUM_D)
	anim.animate("warn", anim.MEDIUM_D)
	anim.animate("resume", anim.DEFAULT_D)
	anim.animate("menu", anim.DEFAULT_D)
	anim.animate("level", anim.FAST_D)
	if state.get(state.key.IS_WIN) then
		gui.set_enabled(gui.get_node("win"), true)
		anim.animate("win", anim.FAST_D)
	end
end

function final(self)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	if action_id == INPUT_1 then
		if action.pressed then
			self.music_chbox:on_checkbox_click()
		end
	elseif action_id == INPUT_2 then
		if action.pressed then
			self.sounds_chbox:on_checkbox_click()
		end
	end
	return self.druid:on_input(action_id, action)
end