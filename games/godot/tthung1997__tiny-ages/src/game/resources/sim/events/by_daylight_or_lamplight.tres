[resource]
script = ExtResource("4_eeb7w")
id = &"by_daylight_or_lamplight"
title = "By daylight or by lamplight"
body = "The square is busy all day, and the evening is when people have time to meet, and the council has been asked whether it ought to sit later."
category = &"settlement"
requires = Array[ExtResource("3_44nei")]([SubResource("Resource_0xuu8"), SubResource("Resource_x6b2f"), SubResource("Resource_3dcqi")])
