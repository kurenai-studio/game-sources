[sub_resource type="Resource" id="Resource_jvav2"]
script = ExtResource("2_7nlxl")
kind = 1
key = &"stone_moulds"

[sub_resource type="Resource" id="Resource_2mcpi"]
script = ExtResource("2_7nlxl")
text = "Moulds were carved from river stone, and lasted for years, and took nearly as long to make."

[sub_resource type="Resource" id="Resource_7k0be"]
script = ExtResource("1_wx7fp")
id = &"carve_stone_moulds"
label = "Carve moulds from stone"
effects = Array[ExtResource("2_7nlxl")]([SubResource("Resource_jvav2"), SubResource("Resource_2mcpi")])

[sub_resource type="Resource" id="Resource_hoo2w"]
script = ExtResource("2_7nlxl")
kind = 1
key = &"clay_moulds"

[sub_resource type="Resource" id="Resource_ii1ud"]
script = ExtResource("2_7nlxl")
text = "Moulds were baked from clay by the dozen, and broke by the dozen, and were made again with some enthusiasm."

[sub_resource type="Resource" id="Resource_44mhf"]
script = ExtResource("1_wx7fp")
id = &"bake_clay_moulds"
label = "Bake them from clay"
effects = Array[ExtResource("2_7nlxl")]([SubResource("Resource_hoo2w"), SubResource("Resource_ii1ud")])

