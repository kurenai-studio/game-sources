key = &"chimney"

[sub_resource type="Resource" id="Resource_3htsw"]
script = ExtResource("2_rfgcu")
text = "A tall clay chimney went up behind the hearth and pulled the air through it like a long cold drink."

[sub_resource type="Resource" id="Resource_7t6b2"]
