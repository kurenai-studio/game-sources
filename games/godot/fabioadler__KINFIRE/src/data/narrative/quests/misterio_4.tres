target = &"any:capital_*_comum1"
text = "Ouça a canção de Salomé numa taberna"

[sub_resource type="Resource" id="Resource_obak8"]
script = ExtResource("3_xy8og")
description = "Ouça a canção nas tabernas antes que ela suma do repertório. A letra fala de emboscadas em estradas que ainda não ardiam."
