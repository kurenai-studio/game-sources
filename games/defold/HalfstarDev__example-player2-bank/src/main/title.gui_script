local level = require "main.level"

local LINEAR = gui.EASING_LINEAR
local active = true
local showing_levels = false

local function start()
	msg.post("/chat#chat", "show")
end

local function set_level(n)
	if level.is_unlocked(n) then
		level.set(n)
		gui.set_text(gui.get_node("level_text"), "Level " .. level.get())
		gui.animate(gui.get_node("level_left"), "color.w", level.is_unlocked(n - 1) and 1 or 0.2, LINEAR, 0.2)
		gui.animate(gui.get_node("level_right"), "color.w", level.is_unlocked(n + 1) and 1 or 0.2, LINEAR, 0.2)
	end
end

local function show_levels(delay)
	set_level(level.get())
	showing_levels = true
	gui.animate(gui.get_node("levels"), "color.w", 1, LINEAR, 3, delay or 0)
end

local function level_right()
	set_level(level.get() + 1)
end

local function level_left()
	set_level(level.get() - 1)
end

local function show()
	active = true
	local duration = 1
	gui.animate(gui.get_node("title"), "color.w", 1, LINEAR, duration)
	set_level(level.get())
	msg.post("/chat#chat", "hide")
	if level.is_unlocked(2) then
		show_levels()
	end
end

local function hide()
	active = false
	local duration = 1
	gui.animate(gui.get_node("title"), "color.w", 0, LINEAR, duration, 0, start)
	msg.post("/bank/notes#notes", "show", {notes = level.get() - 1})
end

function init(self)
	gui.set_render_order(11)
	gui.set_alpha(gui.get_node("logo"), 0)
	gui.set_alpha(gui.get_node("levels"), 0)
	gui.set_alpha(gui.get_node("start"), 0)
	gui.animate(gui.get_node("logo"), "color.w", 1, LINEAR, 1)
	gui.animate(gui.get_node("background"), "color.w", 0.75, LINEAR, 3, 1)
	gui.animate(gui.get_node("start"), "color.w", 0.75, LINEAR, 3, 1)
	if level.is_unlocked(2) then
		show_levels(1)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show") then
		show()
	end
end

function on_input(self, action_id, action)
	if active then
		if showing_levels then
			if action.pressed and action_id == hash("touch") then
				if gui.pick_node(gui.get_node("level_right"), action.x, action.y) then
					level_right()
				elseif gui.pick_node(gui.get_node("level_left"), action.x, action.y) then
					level_left()
				elseif gui.pick_node(gui.get_node("start"), action.x, action.y) then
					hide()
				end
			elseif action.repeated and action_id == hash("right") then
				level_right()
			elseif action.repeated and action_id == hash("left") then
				level_left()
			end
		else
			if action.pressed and action_id == hash("touch") then
				hide()
			end
		end
		if action.pressed and action_id == hash("key_enter") then
			hide()
		end
		return true
	end
end
