[sub_resource type="Resource" id="Resource_purnv"]
script = ExtResource("3_ckroe")
description = "A última página é para você. Ele sabia do primeiro dia — do primeiro passo, do primeiro eco. O Cinzento não é o vigia da vila. É o autor da carta."
