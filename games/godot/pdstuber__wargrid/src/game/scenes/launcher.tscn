[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/launcher.gd" id="1"]

[node name="Launcher" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Box" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
text = "Wargrid"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 40

[node name="Offline" type="Button" parent="Center/Box"]
layout_mode = 2
text = "Play offline"

[node name="FactionRow" type="HBoxContainer" parent="Center/Box"]
layout_mode = 2

[node name="Own" type="OptionButton" parent="Center/Box/FactionRow"]
layout_mode = 2
size_flags_horizontal = 3
