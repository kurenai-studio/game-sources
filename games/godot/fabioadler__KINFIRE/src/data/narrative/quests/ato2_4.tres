text = "Viaje às terras dos Meio-Elfos"

[sub_resource type="Resource" id="Resource_sfnc2"]
script = ExtResource("3_awscc")
description = "Visite as duas capitais e ouça cada lado da rusga. O ódio deles tem uma versão — e ela não combina."
objectives = Array[ExtResource("4_sfnc2")]([SubResource("Resource_ksa53"), SubResource("Resource_awscc")])

[sub_resource type="Resource" id="Resource_0uqx7"]
script = ExtResource("4_sfnc2")
type = 1
target = &"arqueiro_bandido"
count = 5
text = "ladrões de cartas e mensagens"

[sub_resource type="Resource" id="Resource_fn8rc"]
script = ExtResource("3_awscc")
description = "Entre as duas capitas, ladrões de cartas e mensagens se alimentam da discórdia — criaturas que só existem enquanto os dois lados acreditam na briga. Afaste-as."
objectives = Array[ExtResource("4_sfnc2")]([SubResource("Resource_0uqx7")])

[sub_resource type="Resource" id="Resource_5of1b"]
script = ExtResource("4_sfnc2")
