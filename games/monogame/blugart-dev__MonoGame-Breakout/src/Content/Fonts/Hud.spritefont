<?xml version="1.0" encoding="utf-8"?>
<!--
SpriteFont description: the Content Pipeline rasterizes an *installed system
font* into a glyph atlas at build time. There is no runtime TTF rendering in
stock MonoGame - "just draw text" requires one of these.
Arial ships with Windows and macOS; on Linux install the MS core fonts or
change FontName to a font you have installed.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>18</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
