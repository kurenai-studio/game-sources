        {
          "src": "icons/shortcut-continue.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Daily patch",
      "short_name": "Daily",
      "description": "Play today's patch",
      "url": "./?play=daily",
      "icons": [
        {
          "src": "icons/shortcut-daily.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Meadow",
      "short_name": "Meadow",
      "description": "Grow a fresh meadow patch",
      "url": "./?play=meadow",
      "icons": [
        {
          "src": "icons/shortcut-meadow.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
