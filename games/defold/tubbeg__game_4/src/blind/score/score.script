local function table_size(t)
	local i = 0
	for _,_ in pairs(t) do
		i = i + 1
	end
	return i
end

function on_message(self, message_id, message, sender)
	if message_id == hash("play_card") then
		print("received card for scoring", message.rank,message.suit)
		if self.played_cards == nil then self.played_cards = {} end
		table.insert(self.played_cards, {url=sender, rank=message.rank, suit=message.suit})
		if table_size(self.played_cards) == self.sel_nr and self.sel_nr > 0 then
			print("calculating SCORE...")
		end
	end
	if message_id == hash("dec_sel_nr") then
		self.sel_nr = self.sel_nr - 1
		if self.sel_nr < 0 then self.sel_nr = 0 end
	end
	if message_id == hash("inc_sel_nr") then self.sel_nr = self.sel_nr + 1 end
end

