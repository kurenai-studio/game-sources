[resource]
script = ExtResource("2_rxjow")
id = &"ato1_6"
title = "A Primeira Mentira"
summary = "Confrontar o líder. Ele não sabe que mentiu — o Véu fez ele acreditar. A verdade não foi escondida: foi substituída."
