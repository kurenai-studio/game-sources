local player2 = require "player2.player2"
local chat = player2.chat

local game = require "main.game"
local teller = require "main.teller"
local level = require "main.level"
local password = require "main.password"
local inputfield = require "main.inputfield"
local typewriter = require "main.typewriter"

local BACK = hash("back")
local FORWARD = hash("forward")

local wait_animation
local tts_active = false
local stt_active = false
local chat_inputfield
local log = {}
local log_position
local log_latest
local input_box_height = 0
--local lorem = [[Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet. Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet.]]



local function get_text_height(node, text)
	local font = gui.get_font_resource(gui.get_font(node))
	local width = gui.get_size(node).x
	text = text or gui.get_text(node) or ""
	local metrics = resource.get_text_metrics(font, text, {line_break = true, width = width})
	return metrics.height
end

local function set_input_box_height(height)
	if height == input_box_height then
		return
	end
	input_box_height = math.max(height or 0, 382)
	local node = gui.get_node("input_box")
	local node_text = gui.get_node("input_text")
	local duration = 0.2
	gui.animate(node, "size.y", input_box_height, gui.EASING_INOUTSINE, duration)
	gui.animate(node_text, "position.y", input_box_height/4-406/4-7, gui.EASING_INOUTSINE, duration)
end

local function fit_input()
	local node_text = gui.get_node("input_text")
	local height = math.max(get_text_height(node_text) - get_text_height(node_text, "X") + 406, 406)
	if height > input_box_height - 1 then
		set_input_box_height(height)
	end
end

local function set_output_text(s)
	typewriter.start(s or "")
end

-- Animation to show that AI is currently busy thinking
local function start_wait_animation()
	if wait_animation then return end
	local delay = 0.33
	local dots = 0
	wait_animation = timer.delay(delay, true, function()
		dots = dots % 3 + 1
		set_output_text(string.rep(".", dots))
	end)
end

local function stop_wait_animation()
	if wait_animation then
		timer.cancel(wait_animation)
		wait_animation = false
	end
end

local function hide_output()
	local duration = 0.2
	gui.animate(gui.get_node("output"), "color.w", 0, gui.EASING_INOUTSINE, duration)
	msg.post("/bank/robot#robot", "start")
end

local function set_text_scale()
	local node = gui.get_node("output")
	local node_text = gui.get_node("output_text")
	local node_box = gui.get_node("output_box")
	local duration = 0.2
	local height = math.max(gui.get_size(node_text).y + 250, 425)
	local text = gui.get_text(node_text) or ""
	local size = gui.get_size(node_box)
	size.y = height
	local alpha = gui.get_alpha(node)
	if alpha == 0 then
		gui.set_size(node_box, size)
	else
		gui.animate(node_box, "size.y", height, gui.EASING_INOUTSINE, duration)
	end
	if #text == 0 then
		gui.animate(node, "color.w", 0, gui.EASING_INOUTSINE, duration)
	else
		gui.animate(node, "color.w", 1, gui.EASING_INOUTSINE, duration)
	end
	local position = gui.get_position(node)
	if height > 900 then
		position.y = 540
	else
		position.y = 394
	end
	gui.set_position(node, position)
end

local function is_in_table(val, tab)
	for k, v in pairs(tab) do
		if v == val then
			return true
		end
	end
end

local function remove_from_table(tab, val)
	for k, v in pairs(tab) do
		if v == val then
			table.remove(tab, k)
			return true
		end
	end
end

local function add_to_log(s)
	if s and s ~= "" then
		remove_from_table(log, s)
		table.insert(log, s)
	end
end

local function log_back()
	if #log == 0 then return end
	if log_position then
		if log_position == 1 then
			return
		else
			log_position = log_position - 1
		end
	else
		log_latest = chat_inputfield.text or ""
		log_position = #log
	end
	inputfield.set_text(chat_inputfield, log[log_position])
	input_box_height = 0
end

local function log_forward()
	if #log == 0 or not log_position then
		return
	elseif log_position >= #log then
		inputfield.set_text(chat_inputfield, log_latest or "")
		log_position = false
		log_latest = false
	else
		log_position = log_position + 1
		inputfield.set_text(chat_inputfield, log[log_position])
	end
	input_box_height = 0
end

-- Receive text from AI and display it, and speak it if TTS enabled
local function receive(reply, blocked)
	reply = string.gsub(reply, string.char(9), " ")
	stop_wait_animation()
	set_output_text(reply)
	set_text_scale()
	if tts_active then
		tts.speak(reply)
	end
	timer.delay(0.01, false, function()
		msg.post("/bank/robot#robot", "finish_thinking", {blocked = blocked})
	end)
end

-- Post text from player to AI
local function post(s)
	if not s or #s == 0 then return end
	if password.is(s) or s == password.DEBUG then
		game.win()
		return
	end
	add_to_log(s)
	start_wait_animation()
	set_input_box_height(0)
	hide_output()
	teller.speak(s, receive)
	msg.post("/bank/robot#robot", "start_thinking")
	log_position = false
end

local function show()
	gui.animate(gui.get_node("input"), "color.w", 1, gui.EASING_INOUTSINE, 1)
	msg.post("/bank/robot#robot", "start")
	if level.get() == 1 then
		receive("Welcome at SafestBank. How can I help you?")
	end
end




function init(self)
	gui.set_render_order(2)
	gui.set_text(gui.get_node("output_text"), " ")
	typewriter.init("output_text")
	chat.set_config("max_words", 50)
	chat_inputfield = inputfield.new("input_text", post)
	gui.set_alpha(gui.get_node("input"), 0)
	gui.set_alpha(gui.get_node("output"), 0)
end

function update(self, dt)
	inputfield.update()
	fit_input()
end

function on_message(self, message_id, message, sender)
	inputfield.on_message(chat_inputfield, message_id, message)
	if message_id == hash("show") then
		show()
	elseif message_id == hash("hide") then
		hide_output()
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") then
		if action.pressed then
			if gui.pick_node(gui.get_node("stt"), action.x, action.y) then
				if stt_active then
					--stop_stt()
				else
					--start_stt()
				end
			elseif gui.pick_node(gui.get_node("tts"), action.x, action.y) then
				tts_active = not tts_active
				if tts_active then
					gui.set_text(gui.get_node("tts_text"), "Text-to-speech: on")
				else
					gui.set_text(gui.get_node("tts_text"), "Text-to-speech: off")
				end
			end
		end
	elseif action_id == BACK then
		if action.repeated then
			log_back()
		end
	elseif action_id == FORWARD then
		if action.repeated then
			log_forward()
		end
	elseif stt_active then
		if action_id == hash("key_enter") and action.pressed then
			--stop_stt()
		end
	end
	if action_id then
		inputfield.on_input(chat_inputfield, action_id, action)
	end
end
