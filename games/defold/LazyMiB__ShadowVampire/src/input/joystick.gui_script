local onscreen = require("in.onscreen")
local device = require("main.device")
local bus = require("main.bus")

local function setup(self)
	msg.post(".", "acquire_input_focus")
	self.analog = gui.get_node("analog")
	self.button_w = gui.get_node("w")
	self.button_r = gui.get_node("r")
	self.button_esc = gui.get_node("esc")
	self.paused = false
	local player = "player"
	onscreen.register_analog(self.analog, { radius = 80 }, function(action, node, touch)
		if math.abs(touch.x) > 1 or math.abs(touch.y) > 1 then
			-- first position bug
			return
		end
		msg.post(player, "move", touch)
	end)
	onscreen.register_button(self.button_w, nil, function(action, node, touch)
		msg.post(player, "jump", touch)
	end)
	onscreen.register_button(self.button_r, nil, function(action, node, touch)
		msg.post(player, "return", touch)
	end)
	onscreen.register_button(self.button_esc, nil, function(action, node, touch)
		msg.post(player, "pause", touch)
	end)
	self.listener_index = bus.add_listener(bus.name.GAME_PAUSED, function(paused)
		self.paused = paused
	end)
	self.setuped = true
end

function init(self)
	self.setuped = false
	if device.mobile() or device.tablet() then
		gui.set_enabled(gui.get_node("root"), true)
		setup(self)
	end
end

function final(self)
	bus.remove_listener(bus.name.GAME_PAUSED, self.listener_index)
	onscreen.reset()
end

function update(self, dt)
	if not self.setuped then
		return
	end
	local enabled = not self.paused
	local root = gui.get_node("root")
	if enabled ~= gui.is_enabled(root) then
		gui.set_enabled(root, enabled)
	end
end

function on_input(self, action_id, action)
	onscreen.on_input(action_id, action)
end