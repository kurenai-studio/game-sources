[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 256
height = 144
high_dpi = 1
fullscreen = 0

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = ARENA 2D

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

