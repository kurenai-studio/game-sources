[resource]
script = ExtResource("4_84j70")
id = &"the_fog"
title = "Three days of fog"
body = "Fog has lain over the valley for three days, so thick that people have started to call out when they cross the yard."
category = &"nature"
requires = Array[ExtResource("3_pv8hw")]([SubResource("Resource_qvct3"), SubResource("Resource_2v1k4")])
chance_per_tick = 0.05
once = true
