[gd_resource type="Resource" script_class="ContractData"]

script = SubResource("1")

class_name = "ContractData"
id = &"aven_combate_1"
guilda_id = &"aventureiros"
tipo = 0
titulo = "Derrote os Lobos Sombrios"
descricao = "Criaturas das sombras atormentam a estrada entre territórios. Elimine 5 delas."
requisito_nivel = 1
requisito_reputacao = -1
recompensas = {"ouro": 100, "xp": 50}

[sub_resource type="GDScript" id="1"]
script/source = "extends Resource
class_name ContractData

enum Tipo { COMBATE, COLETA, ESCOLTA, INVESTIGACAO }

@export var id: StringName
@export var guilda_id: StringName
@export var tipo: Tipo
@export var titulo: String
@export var descricao: String
@export var requisito_nivel: int = 1
@export var requisito_reputacao: int = -1
@export var recompensas: Dictionary = {}

func _init() -> void:
	resource_name = \"ContractData\"
"
