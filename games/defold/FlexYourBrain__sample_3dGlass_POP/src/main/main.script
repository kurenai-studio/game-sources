function init(self)
	msg.post(".", "acquire_input_focus")
	msg.post("@render:", "use_camera_projection")
	msg.post("camera", "acquire_camera_focus")
	msg.post("@render:", "clear_color", { color = vmath.vector4(0.10, 0.11, 0.12, 0) } )
	
	go.animate("/Pop", "euler.y", go.PLAYBACK_LOOP_FORWARD, -360, go.EASING_INOUTSINE, 14)

end
