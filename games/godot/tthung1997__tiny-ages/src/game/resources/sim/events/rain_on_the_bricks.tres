[sub_resource type="Resource" id="Resource_a108a"]
script = ExtResource("2_ew6u2")
kind = 1
key = &"bricks_roofed"

[sub_resource type="Resource" id="Resource_cc3mn"]
script = ExtResource("2_ew6u2")
text = "The bricks were roofed with reeds, and the rain drummed on the reeds, and the bricks stayed exactly as they were."

[sub_resource type="Resource" id="Resource_2b405"]
script = ExtResource("1_kg56w")
id = &"roof_the_bricks"
label = "Roof them over with reeds"
effects = Array[ExtResource("2_ew6u2")]([SubResource("Resource_a108a"), SubResource("Resource_cc3mn")])

[sub_resource type="Resource" id="Resource_ahx0h"]
script = ExtResource("2_ew6u2")
kind = 1
key = &"bricks_turned"

[sub_resource type="Resource" id="Resource_mkm47"]
script = ExtResource("2_ew6u2")
text = "The bricks were turned one by one, and by the end every hand was the colour of the bricks."

[sub_resource type="Resource" id="Resource_pyae1"]
script = ExtResource("1_kg56w")
id = &"turn_the_bricks"
label = "Turn them as they dry"
effects = Array[ExtResource("2_ew6u2")]([SubResource("Resource_ahx0h"), SubResource("Resource_mkm47")])

