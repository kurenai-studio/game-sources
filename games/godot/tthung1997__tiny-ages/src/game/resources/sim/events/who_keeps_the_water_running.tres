[sub_resource type="Resource" id="Resource_ur6i4"]
script = ExtResource("2_bl6lv")
kind = 1
key = &"water_stewards"

[sub_resource type="Resource" id="Resource_ngokc"]
script = ExtResource("2_bl6lv")
text = "A steward was named for every neighbourhood, and each took up a staff and the job, and the water ran as it always had, only with more opinions."

[sub_resource type="Resource" id="Resource_4yoib"]
script = ExtResource("1_2uldr")
id = &"stewards_by_neighbourhood"
label = "Name a steward for every neighbourhood"
effects = Array[ExtResource("2_bl6lv")]([SubResource("Resource_ur6i4"), SubResource("Resource_ngokc")])

[sub_resource type="Resource" id="Resource_3vd3m"]
script = ExtResource("2_bl6lv")
kind = 1
key = &"water_craft"

[sub_resource type="Resource" id="Resource_mybnl"]
script = ExtResource("2_bl6lv")
text = "The builders of the channels formed a craft, with its own tools and its own habits, and took on apprentices from the first week."

[sub_resource type="Resource" id="Resource_2lp7q"]
script = ExtResource("1_2uldr")
id = &"a_craft_of_the_water"
label = "Let those who build the channels form a craft"
effects = Array[ExtResource("2_bl6lv")]([SubResource("Resource_3vd3m"), SubResource("Resource_mybnl")])

