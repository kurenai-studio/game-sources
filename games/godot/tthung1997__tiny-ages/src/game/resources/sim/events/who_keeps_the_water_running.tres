[resource]
script = ExtResource("4_34pmn")
id = &"who_keeps_the_water_running"
title = "Who keeps the water running"
body = "The water has run for a long time now, and people have begun to ask who will keep it running when the ones who built it are old."
category = &"settlement"
requires = Array[ExtResource("3_plaj3")]([SubResource("Resource_bt1tx"), SubResource("Resource_6qssv"), SubResource("Resource_c8mlt")])
chance_per_tick = 0.05
once = true
choices = Array[ExtResource("1_2uldr")]([SubResource("Resource_4yoib"), SubResource("Resource_2lp7q")])
