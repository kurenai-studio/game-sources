# The fixed catalog of all 117 tiles that exist in a single game.
#
# This mirrors `../trampoline-unity/Assets/Scripts/TokenPool.cs::InitializeTokens()`
# in the original Unity project exactly — same 117 letter pairs, same order
# — so it's the authoritative source for tile pairing, not something to
# redesign. See doc/RULES.md for the rules this data encodes (letter
# distribution, the 2 all-yellow tiles, the 12 shorten tiles).
class_name TilePool
extends RefCounted

# All 117 tiles, in the same fixed order as the Unity source. `Array[Tile]`
# is a typed array — GDScript enforces every element is a `Tile`, similar to
# `std::vector<Tile>` in C++ or `list[Tile]` with a type checker in Python.
var tiles: Array[Tile] = []


func _init() -> void:
	_build_tiles()


# Appends one tile to the catalog. A tiny helper so the 117 lines below
# read as plain data instead of repeating `tiles.append(Tile.new(...))`
# 117 times.
func _add(yellow: String, back: String, back_is_green: bool) -> void:
	tiles.append(Tile.new(yellow, back, back_is_green))


