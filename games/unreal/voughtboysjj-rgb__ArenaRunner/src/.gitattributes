# Normalise text files, treat Unreal binaries as binary.
* text=auto eol=lf

*.uasset binary
*.umap binary
*.upk binary
*.udk binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.dds binary
*.bmp binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.obj binary
*.abc binary

*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.uproject text eol=lf
