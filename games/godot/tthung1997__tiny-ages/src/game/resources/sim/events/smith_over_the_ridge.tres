[sub_resource type="Resource" id="Resource_0r2g1"]
script = ExtResource("2_v6wli")
text = "The stranger worked at the kiln for two days and talked the whole time. By the second night there was a blade, and everyone had held it."

[sub_resource type="Resource" id="Resource_lsv1t"]
