[sub_resource type="Resource" id="Resource_umn8j"]
script = ExtResource("2_tv35x")
text = "The clearest voice was asked to read, and read so well that people came from other streets to listen, and some of them even heard the laws."

[sub_resource type="Resource" id="Resource_yw43r"]
