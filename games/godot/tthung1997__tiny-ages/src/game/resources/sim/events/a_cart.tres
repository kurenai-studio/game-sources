text = "The Wheel and the Road"

[sub_resource type="Resource" id="Resource_nwq42"]
script = ExtResource("2_ywvw1")
text = "Two heavy discs were cut from a trunk and an axle run through them. It creaked, and it rolled, and it was carrying firewood before it was finished."

