{
    "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "Lua 5.4",
        "pathStrict": true
    },
    "type": {
        "checkTableShape": true
    },
    "diagnostics": {
        "enable": true,
        "globals": []
    },
    "workspace": {
        "checkThirdParty": false,
        "library": [
            "${3rd}/love2d/library"
        ]
    }
}
