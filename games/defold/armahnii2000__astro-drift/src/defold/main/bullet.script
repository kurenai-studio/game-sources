-- Bullet: lives 1s, wraps screen, deletes itself.
local W, H = 960, 540

function init(self)
	self.life = 1.0
	self.velocity = vmath.vector3()
end

function update(self, dt)
	local pos = go.get_position()
	pos = pos + self.velocity * dt
	if pos.x < 0 then pos.x = pos.x + W end
	if pos.x > W then pos.x = pos.x - W end
	if pos.y < 0 then pos.y = pos.y + H end
	if pos.y > H then pos.y = pos.y - H end
	go.set_position(pos)
	self.life = self.life - dt
	if self.life <= 0 then
		go.delete()
	end
end
