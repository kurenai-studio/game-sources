
local function table_size(t)
	local i = 0
	for _,_ in pairs(t) do
		i = i + 1
	end
	return i
end

local function init_std_52_deck()
	local deck = {}
	local suits = {"spades","hearts","clubs","diamonds"}
	for j=1,4 do
		local s = suits[j]
		for i=2,14 do
			local id = factory.create("#factory")
			msg.post(id,"set_card", {rank=i, suit=s})
			table.insert(deck, id)
		end
	end
	return deck
end



local function set_parent(cards)
	for _, card in pairs(cards) do
		local id_msg =
		{
			deck=go.get_id(),
			discard=go.get_id("discard"),
			hand=go.get_id("hand"),
			score=go.get_id("score"),
		}
		msg.post(card, "set_ids", id_msg)
	end
end

function init(self)
	self.deck = init_std_52_deck()
	set_parent(self.deck)
end

