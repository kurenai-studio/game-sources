{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "exec node --test --test-isolation=none test/model.test.js test/tetromino.test.js test/factory.test.js test/game.test.js test/gameManager.test.js test/session.test.js test/safety.test.js test/inputController.test.js"
  },
  "mutate": [
    "public/game/**/*.js"
  ],
  "ignorePatterns": [
    "coverage",
    "test-results",
    "playwright-report",
    "reports"
  ],
  "tsconfigFile": "no-tsconfig-rewrite.json",
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 20000,
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 100
  }
}
