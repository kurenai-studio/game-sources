---
import { getCollection, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { formatDate, isoDate } from '../lib/dates';

const releases = (await getCollection('releases')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(releases.map(async (r) => ({ ...r, Content: (await render(r)).Content })));
---

<Page title="Changelog" description="What changed in each version of SPPPD.">
  <p slot="lede" class="muted">What changed in each version, newest first. What's next is on the <a href="/roadmap/">roadmap</a>.</p>
  {
    rendered.map(({ data, Content }) => (
      <article class="release prose" id={`v${data.version}`}>
        <h2>
          <a href={`#v${data.version}`}>{data.version}</a>
        </h2>
        <p class="muted">
          <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
        </p>
        <Content />
      </article>
    ))
  }
</Page>

<style>
  .release {
    padding-top: 2.5rem;
    margin-top: 2.5rem;
    border-top: 3px dashed var(--road-line);
  }

  .release:first-of-type {
    border-top: 0;
    margin-top: 1rem;
    padding-top: 0;
  }

  .release h2 {
    margin: 0 0 0.25rem;
  }

  .release h2 a {
    color: inherit;
    text-decoration: none;
  }
</style>
