[sub_resource type="Resource" id="Resource_q45yg"]
script = ExtResource("2_mdteq")
kind = 1
key = &"street_gutters"

[sub_resource type="Resource" id="Resource_ytu33"]
script = ExtResource("2_mdteq")
text = "A gutter was cut along the lane's edge, and the next rain ran neatly into it, and the children floated sticks down it, and held races."

[sub_resource type="Resource" id="Resource_7bkq7"]
script = ExtResource("3_4c80u")
kind = 2
key = &"wood"
amount = 6

[sub_resource type="Resource" id="Resource_2vv08"]
script = ExtResource("1_onccm")
id = &"cut_a_gutter"
label = "Cut a gutter along the lane's edge"
requires = Array[ExtResource("3_4c80u")]([SubResource("Resource_7bkq7")])
effects = Array[ExtResource("2_mdteq")]([SubResource("Resource_6xwhy"), SubResource("Resource_q45yg"), SubResource("Resource_ytu33")])

[sub_resource type="Resource" id="Resource_2eje1"]
script = ExtResource("2_mdteq")
kind = 1
key = &"street_tilted"

[sub_resource type="Resource" id="Resource_eag33"]
script = ExtResource("2_mdteq")
text = "The lane was tilted toward the river a little more each week, and the rain learned the way, and the lane was dry by noon."

[sub_resource type="Resource" id="Resource_86je0"]
script = ExtResource("1_onccm")
id = &"let_it_run_to_the_water"
label = "Let it run, and tilt the lane toward the river"
effects = Array[ExtResource("2_mdteq")]([SubResource("Resource_2eje1"), SubResource("Resource_eag33")])

