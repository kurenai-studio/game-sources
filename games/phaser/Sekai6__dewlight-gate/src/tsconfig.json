{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@webgpu/types"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
