[resource]
script = ExtResource("4_edeqi")
id = &"looking_back"
title = "Up at the cave"
body = "{subject} climbed up to the cave this evening, and sat in the mouth of it for a long while, looking down at the roofs."
requires = Array[ExtResource("3_vfm1k")]([SubResource("Resource_yhbwp"), SubResource("Resource_cmj1o")])
needs_subject = true
subject_requires = Array[ExtResource("3_vfm1k")]([SubResource("Resource_xqsno")])
trait_weights = Dictionary[StringName, float]({
&"nature_loving": 3.0
})
chance_per_tick = 0.05
once = true
choices = Array[ExtResource("1_x6nmr")]([SubResource("Resource_qle70"), SubResource("Resource_ujwyb")])
