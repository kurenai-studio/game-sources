target = &"arqueiro_bandido"
count = 5
text = "bandidos que lucram com a fronteira"

[sub_resource type="Resource" id="Resource_564eh"]
script = ExtResource("3_1klw6")
description = "Entre as duas capitas, bandidos que lucram com a fronteira se alimentam da discórdia — criaturas que só existem enquanto os dois lados acreditam na briga. Afaste-as."
objectives = Array[ExtResource("4_roof0")]([SubResource("Resource_dy0f5")])

[sub_resource type="Resource" id="Resource_06pgm"]
script = ExtResource("4_roof0")
