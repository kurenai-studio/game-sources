# Cloudflare Pages HTTP Headers Configuration

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# 針對純 ESM 模組採用 no-cache，確保部署新版時瀏覽器立即載入最新程式碼，避免新舊檔案混用衝突
/src/*
  Cache-Control: no-cache, must-revalidate

/css/*
  Cache-Control: no-cache, must-revalidate

# 靜態圖片等資源可適度快取
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
