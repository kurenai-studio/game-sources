key = &"door_stones"

[sub_resource type="Resource" id="Resource_bjyqu"]
script = ExtResource("2_q1uf7")
text = "A flat stone went down at every door, and the mud stayed outside for nearly a week."

[sub_resource type="Resource" id="Resource_jvmd8"]
