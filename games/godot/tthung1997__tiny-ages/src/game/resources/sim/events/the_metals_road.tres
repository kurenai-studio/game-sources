[sub_resource type="Resource" id="Resource_5dwtd"]
script = ExtResource("2_gtgd8")
text = "Two villagers went up the stream with empty sacks and came back a week later with full ones and a great many opinions."

[sub_resource type="Resource" id="Resource_epvup"]
