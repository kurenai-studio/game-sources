key = &"searched_together"

[sub_resource type="Resource" id="Resource_uacha"]
script = ExtResource("2_dy4pl")
text = "The whole group searched the cave, and found the flint, and a good many other lost things."

[sub_resource type="Resource" id="Resource_6yfiv"]
