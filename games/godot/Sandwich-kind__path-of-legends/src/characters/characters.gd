# Включён ли «МЕГА» у игрока 1 и 2 (кнопка под героем на выборе легенд)
static var mega_on := [false, false]

const MEGA_PRICE := 150

# Открыта ли легенда (за боссов — после победы над боссом, из Лавки — после покупки)
# Порядок, в котором легенды листаются при выборе (Дуэль, Арена) и стоят в Книге легенд:
#   сначала стартовые, потом из Лавки, потом открытые на Арене (по номеру волны босса),
#   а тестовые TESTIK_1 и UBER_TESTIK_2 — всегда в самом конце.
# Номера легенд в LIST не меняются (на них завязаны сохранения), меняется только порядок показа.
const TEST_NAMES := ["TESTIK_1", "UBER_TESTIK_2"]
static var _order: Array = []

static func display_order() -> Array:
	if _order.size() == LIST.size():
		return _order
	var start: Array = []
	var shop: Array = []
	var arena: Array = []
	var test: Array = []
	for i in LIST.size():
		var ch: Dictionary = LIST[i]
		if ch["name"] in TEST_NAMES:
			test.append(i)
		elif ch.has("price"):
			shop.append(i)
		elif ch.has("unlock"):
			arena.append(i)
		else:
			start.append(i)
	arena.sort_custom(func(a, b): return Bots.first_wave(LIST[a]["unlock"]) < Bots.first_wave(LIST[b]["unlock"]))
	_order = start + shop + arena + test
	return _order

# Соседняя легенда в порядке показа (d = +1 вперёд, -1 назад), по кругу
static func step(i: int, d: int) -> int:
	var order := display_order()
	var k := order.find(i)
	if k < 0:
		k = 0
	return order[wrapi(k + d, 0, order.size())]

static func unlocked(i: int) -> bool:
	var ch: Dictionary = LIST[i]
	if ch.has("price"):
		return Save.owns_hero(ch["name"])
	return not ch.has("unlock") or Save.hero_unlocked(ch["unlock"])

static func unlock_text(i: int) -> String:
	if LIST[i].has("price"):
		return "Купи в Лавке за %d монет" % LIST[i]["price"]
	var b: String = LIST[i].get("unlock", "")
	if b == "":
		return ""
	return "Победи босса «%s» на Арене" % Bots.TYPES[b]["name"]

# Создаёт героя по номеру персонажа из LIST
static func create(char_idx: int, prefix: String, index: int, team: int,
		spawn: Vector2, facing: int, outline: Color) -> Player:
	var p := Player.new()
	p.prefix = prefix
	p.index = index
	p.team = team
	p.spawn = spawn
	p.facing = facing
	p.outline = outline
	var ch: Dictionary = LIST[char_idx]
	p.color = ch["color"]
	p.speed = ch["speed"]
	p.bullet_speed = ch["bullet_speed"]
	p.bullet_damage = ch["bullet_damage"]
	p.bullet_blast = ch["bullet_blast"]
	p.fire_cooldown = ch["fire_cooldown"]
	p.bullet_size = ch["bullet_size"]
	p.clip_size = ch["clip"]
	p.reload_time = ch["reload"]
	p.abilities = ch["abilities"].duplicate()
	p.ability_cds = ch["cds"].duplicate()
	p.ult = ch["ult"]
	p.max_hp = ch["hp"]
	p.mega_cd = ch["mega_cd"]
	p.rig_kind = ch.get("rig", "")
	p.ult_need = float(ch.get("ult_need", p.ult_need))
	# «МЕГА» из Лавки: только если куплено для этой легенды и включено на выборе
	p.mega_mode = index < mega_on.size() and mega_on[index] and Save.has_mega(ch["name"])
	if ch.has("kit"):
		var k: HeroKit = HeroKit.new()
		if ch["kit"] in ["hunter", "smith"]:
			k = StarterKit.new()
		elif ch["kit"] in ["soldier", "samurai"]:
			k = EliteKit.new()
		elif ch["kit"] == "prism":
			k = PrismKit.new()
		elif ch["kit"] == "assassin":
			k = AssassinKit.new()
		elif ch["kit"] == "osoka":
			k = OsokaKit.new()
		elif ch["kit"] == "zarnitsa":
			k = ZarnitsaKit.new()
		elif ch["kit"] == "rassvet":
			k = RassvetKit.new()
		elif ch["kit"] == "pivozavr":
			k = PivozavrKit.new()
		k.hero = ch["kit"]
		k.p = p
		p.kit = k
	return p
