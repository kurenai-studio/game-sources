[sub_resource type="Resource" id="Resource_bfp3y"]
script = ExtResource("2_rfgcu")
kind = 1
key = &"bellows"

[sub_resource type="Resource" id="Resource_wlclv"]
script = ExtResource("2_rfgcu")
text = "A hide bag and a clay pipe made a bellows, and the hearth breathed in and out like something alive."

[sub_resource type="Resource" id="Resource_yvbxf"]
