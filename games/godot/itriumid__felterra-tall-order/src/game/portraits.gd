static var _cache := {}


## Who's speaking a line, as the cast knows them: "elder", "jogiboy", or a cat's name ("Nenek Pus"
## is "nenek_pus").
static func key(who: String) -> String:
	return who.to_lower().replace(" ", "_")


## Whether there's a portrait for someone.
static func has(who: String) -> bool:
	return CAST.has(key(who)) or key(who) == "jogiboy"


## A portrait's art: who's speaking, in a mood (neutral if it isn't one).
static func art(who: String, mood := "neutral") -> String:
	var id := key(who)
	if not mood in MOODS:
		mood = "neutral"
	if id == "jogiboy":
		return JOGIBOY.get(mood, JOGIBOY.neutral)
	var letters: String = Sprites.COATS.get(CAST.get(id, "orange"), Sprites.COATS.orange)
	var face: String = FACES[mood]
	var touches: String = TOUCHES.get(id, "")
	var drawn := ""
	for index in face.length():
		var touch := touches[index] if index < touches.length() else "."
		var fur := (Sprites.COATS.orange as String).find(face[index])
		if touch != "." and touch != "\n":
			drawn += touch
		elif fur >= 0:
			drawn += letters[fur]
		else:
			drawn += face[index]
	return drawn


## A portrait as a texture, made once.
static func texture(who: String, mood := "neutral") -> ImageTexture:
	var cache_key := key(who) + "|" + mood
	if not _cache.has(cache_key):
		_cache[cache_key] = ImageTexture.create_from_image(Sprites.image(art(who, mood)))
	return _cache[cache_key]
