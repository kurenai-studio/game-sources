Button/colors/font_pressed_color = Color(0.784314, 0.85098, 1, 1)
Button/styles/normal = SubResource("StyleBoxFlat_btn_normal")
Button/styles/hover = SubResource("StyleBoxFlat_btn_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
Button/styles/focus = SubResource("StyleBoxFlat_btn_focus")

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_main_menu")
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0862745, 0.0980392, 0.129412, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TitleRow" type="HBoxContainer" parent="Center/VBox"]
layout_mode = 2
theme_override_constants/separation = 18
alignment = 1

[node name="Logo" type="TextureRect" parent="Center/VBox/TitleRow"]
custom_minimum_size = Vector2(132, 74)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("2_logo")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Center/VBox/TitleRow"]
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 48
text = "Controller Dojo"
horizontal_alignment = 1

[node name="StickTrainingButton" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 56)
layout_mode = 2
text = "Stick Training"

[node name="MovementTrainingButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(300, 56)
layout_mode = 2
text = "Movement Training"

[node name="MazeRow" type="HBoxContainer" parent="Center/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="MazeButton" type="Button" parent="Center/VBox/MazeRow"]
custom_minimum_size = Vector2(300, 56)
layout_mode = 2
size_flags_horizontal = 3
text = "Maze"

[node name="HardModeToggle" type="Button" parent="Center/VBox/MazeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 56)
layout_mode = 2
tooltip_text = "Don't touch the walls: 3 strikes and the maze restarts."
theme_override_font_sizes/font_size = 22
toggle_mode = true
text = "Hard: off"

[node name="QuitButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(300, 56)
layout_mode = 2
text = "Quit"

[node name="Hint" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.552941, 0.6, 0.717647, 1)
theme_override_font_sizes/font_size = 18
text = "D-pad to move, A to choose"
horizontal_alignment = 1

[node name="ControllerTestButton" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 36)
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -112.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 52.0
grow_horizontal = 0
tooltip_text = "Controller input test screen."
theme_override_font_sizes/font_size = 18
text = "Test"

[connection signal="pressed" from="ControllerTestButton" to="." method="_on_controller_test_pressed"]
[connection signal="pressed" from="Center/VBox/StickTrainingButton" to="." method="_on_stick_training_pressed"]
[connection signal="pressed" from="Center/VBox/MovementTrainingButton" to="." method="_on_movement_training_pressed"]
[connection signal="pressed" from="Center/VBox/MazeRow/MazeButton" to="." method="_on_maze_pressed"]
[connection signal="toggled" from="Center/VBox/MazeRow/HardModeToggle" to="." method="_on_hard_mode_toggled"]
[connection signal="pressed" from="Center/VBox/QuitButton" to="." method="_on_quit_pressed"]
