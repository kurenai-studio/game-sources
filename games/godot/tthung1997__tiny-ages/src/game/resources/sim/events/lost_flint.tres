key = &"wrestled"

[sub_resource type="Resource" id="Resource_n5472"]
script = ExtResource("2_dy4pl")
text = "They wrestled in the firelight until both were laughing, and the flint turned up in a boot."

[sub_resource type="Resource" id="Resource_fqg5x"]
