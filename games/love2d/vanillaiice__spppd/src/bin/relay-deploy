#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# The server's details and the dashboard's password live in .env, outside git.
env_file="${SPPPD_ENV:-.env}"
[ -f "$env_file" ] || { echo "$env_file is missing. It needs SPPPD_HOST, SPPPD_SSH_USER and SPPPD_DOMAIN." >&2; exit 1; }
set -a; . "$env_file"; set +a
: "${SPPPD_HOST:?is not set in $env_file}" "${SPPPD_SSH_USER:?is not set in $env_file}" "${SPPPD_DOMAIN:?is not set in $env_file}"

# The first run makes the password for the dashboard user admin.
if [ -z "${SPPPD_DASHBOARD_TOKEN:-}" ]; then
  SPPPD_DASHBOARD_TOKEN="$(openssl rand -hex 24)"
  printf 'SPPPD_DASHBOARD_TOKEN=%s\n' "$SPPPD_DASHBOARD_TOKEN" >> "$env_file"
  export SPPPD_DASHBOARD_TOKEN
  echo "Added the dashboard password for the user admin to $env_file."
fi

make relay-linux

# The relay runs as the deploy user, so it can write the data folder Kamal makes.
SPPPD_RELAY_USER="$(ssh "$SPPPD_SSH_USER@$SPPPD_HOST" 'echo "$(id -u):$(id -g)"')"
export SPPPD_RELAY_USER

# With SPPPD_BACKUP=on in .env, Litestream goes first. On a new server it restores
# the database before the relay can make an empty one, which it would back up over
# the good copy. If that fails, the relay isn't touched.
if [ "${SPPPD_BACKUP:-off}" = on ]; then
  ./bin/backup-deploy
fi

# Reboot works for a first deploy too. Anyone racing is told the server is restarting.
"${KAMAL_BIN:-kamal}" accessory reboot relay "$@"

# Then check it answers from outside, without showing in its analytics.
SPPPD_ENV="$env_file" ./bin/relay-check
