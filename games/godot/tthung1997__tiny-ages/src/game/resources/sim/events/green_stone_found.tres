script = ExtResource("4_tnjdq")
id = &"green_stone_found"
title = "A green stone"
body = "{subject} brought back a stone from a stream in the hills, streaked bright green. It sat in the cook fire all night, and in the morning there was a bead of something red and gold in the ashes."
