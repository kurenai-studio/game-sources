## The cat's whole body in a view and a frame of its walk: the body, and that frame's legs. In
## boots, his feet are leather.
static func cat_body_art(view: String, frame: int, boots: Variant = false, paws := "") -> String:
	# Built once for each way it can be asked for: every cat on screen asks every frame.
	var key := "body|%s|%d|%s|%s" % [view, frame % 4, boots, paws]
	if not _cache.has(key):
		_cache[key] = _build_body_art(view, frame, boots, paws)
	return _cache[key]


static func _build_body_art(view: String, frame: int, boots: Variant, paws: String) -> String:
	# His hind feet drawn in a letter: leather for boots (true), or what's given; his front paws in
	# theirs, for gloves and bands. Bare, both are cream.
	var feet: String = "B" if boots is bool and boots else (boots if boots is String else "")
	var rows: Array[String] = []
	rows.assign((CAT_UPPER[view] as String).strip_edges().split("\n"))
	for row in (CAT_LEGS[view][frame % 4] as String).strip_edges().split("\n"):
		rows.append(row.replace("w", feet if not feet.is_empty() else "w").replace("X", paws if not paws.is_empty() else "w"))
	return "\n".join(rows)


## How far the body leans in a frame of the walk: on four legs, it doesn't.
static func lean(_view: String, _frame: int) -> int:
	return 0


## A card's picture of an item: Tompel wearing it, seen from the side it shows best on, framed on
## where it's worn. Weapons are shown in his mouth, dodge mutations as their signs.
static func preview(item: String) -> Texture2D:
	var key := "preview|" + item
	if _cache.has(key):
		return _cache[key]
	var picture: Image
	if MUTATION_ART.has(item):
		picture = image(MUTATION_ART[item])
	elif item == "gun_drone":
		picture = image(DRONE_FRAMES[0])
	elif item == "meriam_bambu":
		picture = image(MERIAM_BAMBU)
	elif item == "mines":
		picture = image(MINE)
	elif item == "net_drone":
		picture = image(swapped(DRONE_FRAMES[0], NET_DRONE_COLORS))
	elif item == "layang_layang":
		picture = image(KITE)
	elif item == "ranjau_bambu":
		picture = image(SPIKES)
	elif item == "radio":
		picture = image(RADIO)
	elif item == "bee_swarm":
		picture = image(BEE_HIVE)
	elif item == "alarm_drum":
		picture = image(ALARM_DRUM)
	elif item == "snare":
		picture = image(SNARE)
	elif held_art().has(item):
		# A weapon is shown in his mouth, side-on: on its own, a gun is a few pixels. The picture is
		# wider than he is, for what sticks out ahead of him.
		var body := image(coat(cat_body_art("side", 0), "tompel", "side"))
		picture = Image.create(40, 24, false, body.get_format())
		picture.blend_rect(body, Rect2i(Vector2i.ZERO, body.get_size()), Vector2i.ZERO)
		var held: Dictionary = held_art()[item].east
		var mouth: Vector2 = CAT_HOLDS.side.mouth
		picture.blend_rect(image(held.art), Rect2i(Vector2i.ZERO, image(held.art).get_size()), Vector2i(mouth - held.grip))
		picture = picture.get_region(Rect2i(12, 4, 22, 18))
	else:
		# Seen from the side it's worn on: his head, eyes and neck from the front, the rest side-on.
		var view := "front" if HATS.has(item) or GEAR_FRONT.has(item) else "side"
		var art := coat(cat_body_art(view, 0, FEET.get(item, ""), PAWS.get(item, "")), "tompel", view)
		picture = image(art)
		var layer := ""
		if BODIES.has(item):
			layer = BODIES[item][view]
		elif WORN.has(item):
			layer = WORN[item][view]
		if not layer.is_empty():
			picture.blend_rect(image(layer), Rect2i(0, 0, 24, 24), Vector2i.ZERO)
		if HATS.has(item):
			var hat := image(HATS[item])
			picture.blend_rect(hat, Rect2i(Vector2i.ZERO, hat.get_size()), Vector2i(CAT_ANCHORS[view].head))
		picture = picture.get_region(Rect2i(1, 2 if view == "front" else 5, 22, 18))
	var texture := ImageTexture.create_from_image(picture)
	_cache[key] = texture
	return texture


## The view to draw a cat facing a direction in, and whether to mirror it.
static func cat_view(facing: Vector2) -> Array:
	if absf(facing.y) > absf(facing.x):
		return ["front" if facing.y > 0.0 else "back", false]
	return ["side", facing.x < 0.0]


## Where he holds a thing in a view, his mouth or his tail's base, mirrored if the view is.
static func hold(view: String, flip: bool, what: String) -> Vector2:
	var point: Vector2 = CAT_HOLDS[view][what]
	if flip:
		point.x = 23 - point.x
	return point


## An anchor for a view, mirrored if the view is: the head is an offset the hat is moved by, so it
## mirrors about the hat's own place.
static func cat_anchor(view: String, flip: bool, anchor: String) -> Vector2:
	var point: Vector2 = CAT_ANCHORS[view][anchor]
	if flip:
		point.x = -point.x
	return point


static func image(art: String) -> Image:
	# Art opens with a line break after its quotes; blank rows after that are clear rows, kept.
	var rows := art.replace("\r", "").trim_prefix("\n").rstrip("\n").split("\n")
	var width := 0
	for row in rows:
		width = maxi(width, row.length())
	var picture := Image.create_empty(width, rows.size(), false, Image.FORMAT_RGBA8)
	for y in rows.size():
		for x in rows[y].length():
			var key := rows[y][x]
			if LEGEND.has(key):
				picture.set_pixel(x, y, LEGEND[key])
	return picture


## The art with some of its pixels gone, for remains crumbling away: stage 0 is whole, and each
## stage up to STAGES drops more, in a fixed scattered order so it dissolves rather than fades.
const STAGES := 4


static func crumbled(art: String, stage: int, flip_x := false, flip_y := false) -> CanvasTexture:
	var key := "crumbled|%s|%d|%s|%s" % [art.hash(), stage, flip_x, flip_y]
	if _cache.has(key):
		return _cache[key]
	var picture := image(art)
	if flip_x:
		picture.flip_x()
	if flip_y:
		picture.flip_y()
	for y in picture.get_height():
		for x in picture.get_width():
			# A fixed scatter: each pixel has its own moment to go.
			var moment := float((x * 7 + y * 13 + x * y * 3) % 17) / 17.0
			if moment < float(stage) / STAGES:
				picture.set_pixel(x, y, Color(0, 0, 0, 0))
	var texture := CanvasTexture.new()
	texture.diffuse_texture = ImageTexture.create_from_image(picture)
	_cache[key] = texture
	return texture


## The art as a texture lit by the scene's lights, with a normal map raised from its own shape:
## each pixel tilts toward the nearest edge, so light from one side models the form.
## Art with some of its letters swapped for others: the same drawing, repainted.
static func swapped(art: String, mapping: Dictionary) -> String:
	var key := "swap|%d|%s" % [art.hash(), str(mapping)]
	if _cache.has(key):
		return _cache[key]
	var result := ""
	for character in art:
		result += mapping.get(character, character)
	_cache[key] = result
	return result


## Art of a cat in another coat: its fur's letters swapped for that coat's.
static func coat(art: String, coat_name: String, view := "") -> String:
	var letters: String = COATS.get(coat_name, COATS.orange)
	if letters == COATS.orange:
		return art
	var key := "coat|%d|%s|%s" % [art.hash(), coat_name, view]
	if _cache.has(key):
		return _cache[key]
	var rows := art.split("\n")
	var fur: String = COATS.orange
	# His nose: the pink below his eyes, where his mole is placed from.
	var mole := Vector2i(-1, -1)
	if coat_name == "tompel" and TOMPEL_MOLE.has(view):
		for y in range(TOMPEL_NOSE_FROM[view], rows.size()):
			if rows[y].find("p") >= 0:
				mole = Vector2i(rows[y].find("p"), y) + TOMPEL_MOLE[view]
				break
	for y in rows.size():
		var row := rows[y]
		var swapped := ""
		for x in row.length():
			var index := fur.find(row[x])
			if Vector2i(x, y) == mole and row[x] != "k":
				# The mole sits on his muzzle as readily as on his fur.
				swapped += (COATS.black as String)[1]
				continue
			var marked := coat_name == "tompel" and index >= 0 and _tompel_marked(view, x, y)
			swapped += ((COATS.black as String)[index] if marked else letters[index]) if index >= 0 else row[x]
		rows[y] = swapped
	var result := "\n".join(rows)
	_cache[key] = result
	return result


## Whether a pixel of fur is one of Tompel's black markings, in a view.
static func _tompel_marked(view: String, x: int, y: int) -> bool:
	for mark: Dictionary in TOMPEL_MARKS.get(view, []):
		if y >= mark.rows.x and y <= mark.rows.y and x >= mark.columns.x and x < mark.columns.y:
			return true
	return false


static func lit(art: String, flip_x := false, flip_y := false) -> CanvasTexture:
	var key := "%s|%s|%s" % [art.hash(), flip_x, flip_y]
	if _cache.has(key):
		return _cache[key]
	var picture := image(art)
	if flip_x:
		picture.flip_x()
	if flip_y:
		picture.flip_y()
	var texture := CanvasTexture.new()
	texture.diffuse_texture = ImageTexture.create_from_image(picture)
	texture.normal_texture = ImageTexture.create_from_image(_normals(picture))
	_cache[key] = texture
	return texture


static func _normals(picture: Image) -> Image:
	var width := picture.get_width()
	var height := picture.get_height()
	var depth := PackedFloat32Array()
	depth.resize(width * height)
	for y in height:
		for x in width:
			depth[y * width + x] = _depth(picture, x, y)
	var normals := Image.create_empty(width, height, false, Image.FORMAT_RGBA8)
	for y in height:
		for x in width:
			if picture.get_pixel(x, y).a == 0.0:
				continue
			var left := depth[y * width + maxi(x - 1, 0)]
			var right := depth[y * width + mini(x + 1, width - 1)]
			var up := depth[maxi(y - 1, 0) * width + x]
			var down := depth[mini(y + 1, height - 1) * width + x]
			var normal := Vector3(left - right, down - up, 1.6).normalized()
			normals.set_pixel(x, y, Color(normal.x * 0.5 + 0.5, normal.y * 0.5 + 0.5, normal.z * 0.5 + 0.5))
	return normals


## How far a pixel is from the sprite's edge, up to three: a rough bulge to light.
static func _depth(picture: Image, x: int, y: int) -> float:
	if picture.get_pixel(x, y).a == 0.0:
		return 0.0
	for reach in range(1, 4):
		for offset: Vector2i in [Vector2i(reach, 0), Vector2i(-reach, 0), Vector2i(0, reach), Vector2i(0, -reach)]:
			var other := Vector2i(x, y) + offset
			if other.x < 0 or other.y < 0 or other.x >= picture.get_width() or other.y >= picture.get_height() \
					or picture.get_pixel(other.x, other.y).a == 0.0:
				return float(reach)
	return 3.0


## The gun pointing as near as it can to a direction, as {texture, grip, muzzle}: the drawn angle
## closest to it, mirrored into place.
## Everything he can hold, drawn: the first weapons here, and the arsenal's.
static func held_art() -> Dictionary:
	if _held.is_empty():
		_held = GUNS.duplicate()
		_held.merge(ArsenalArt.WEAPONS)
	return _held


static func gun_toward(weapon: String, direction: Vector2) -> Dictionary:
	var octant := wrapi(roundi(direction.angle() / (PI / 4.0)), 0, 8)
	# Screen y points down, so octant 2 is south, 6 is north.
	var choice: Array = [
		["east", false, false], ["northeast", false, true], ["north", false, true], ["northeast", true, true],
		["east", true, false], ["northeast", true, false], ["north", false, false], ["northeast", false, false],
	][octant]
	var drawing: Dictionary = held_art()[weapon][choice[0]]
	var size := image(drawing.art).get_size()
	var grip: Vector2 = drawing.grip
	var muzzle: Vector2 = drawing.muzzle
	if choice[1]:
		grip.x = size.x - 1 - grip.x
		muzzle.x = size.x - 1 - muzzle.x
	if choice[2]:
		grip.y = size.y - 1 - grip.y
		muzzle.y = size.y - 1 - muzzle.y
	return {"texture": lit(drawing.art, choice[1], choice[2]), "grip": grip, "muzzle": muzzle, "behind": octant >= 5 and octant <= 7}
