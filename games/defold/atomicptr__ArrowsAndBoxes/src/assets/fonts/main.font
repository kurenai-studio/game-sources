font: "/assets/fonts/Kenney Mini Square Mono.ttf"
material: "/builtins/fonts/font.material"
size: 8
shadow_alpha: 1.0
shadow_blur: 4
shadow_x: 2.0
shadow_y: 2.0
characters: " !\"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
styles {
  name: "default"
}
styles {
  name: "link"
  markup: "<color=#1972e5><ul>"
}
styles {
  name: "link:hover"
  markup: "<color=#4ca5ff>"
}
styles {
  name: "link:active"
  markup: "<color=#0c4cb2>"
}
