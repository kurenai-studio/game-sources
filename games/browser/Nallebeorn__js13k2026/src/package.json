{
	"type": "module",
	"scripts": {
		"build-once": "node generate-bin-data.ts && vite build",
		"build-once-wavedash": "node generate-bin-data.ts && vite build --mode wavedash",
		"build": "vite build --watch",
		"build-wavedash": "vite build --watch --mode wavedash",
		"preview": "vite preview",
		"dev": "vite",
		"test": "vitest",
		"tsc": "tsc --watch",
		"bindata": "node --watch generate-bin-data.ts"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@wvdsh/sdk-js": "^1.3.48",
		"geometry-interfaces": "^2.0.0",
		"terser": "^5.50.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vite-plugin-glsl": "^1.6.1",
		"vitest": "^4.1.10"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.19.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@11.21.0",
	"dependencies": {
		"gl-matrix": "^3.4.4",
		"vite-plugin-singlefile": "^2.3.3"
	}
}
