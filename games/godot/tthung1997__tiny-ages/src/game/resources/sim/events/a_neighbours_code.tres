[resource]
script = ExtResource("4_1lwn1")
id = &"a_neighbours_code"
title = "A neighbour's code"
body = "The far shore's laws are long and thorough, and some of them are plainly meant for a different sort of town, and somebody has to choose."
requires = Array[ExtResource("3_dphsd")]([SubResource("Resource_te57n"), SubResource("Resource_fvpik"), SubResource("Resource_up1gy"), SubResource("Resource_mh53m"), SubResource("Resource_py3p6")])
