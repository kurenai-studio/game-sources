local world = require("game.world")
local decore = require("decore.decore")
local systems = require("system.systems")
local entities = require("entity.entities")

local input_command = require("system.input.input_command")
local game_manager_command = require("system.game_manager.game_manager_command")

---@class script.game
---@field world world

---@param self script.game
function init(self)
	decore.register_entities("game", entities.get_entities())

	self.world = decore.new_world(systems.get_systems())
	world.set_world(self.world)

	if sys.get_engine_info().is_debug then
		self.world:addEntity(decore.create_prefab("debug_panel"))
	end

	timer.delay(0, false, function()
		game_manager_command.start_game()
	end)
end


---@param self script.game
function final(self)
	self.world:clearEntities()
	self.world:clearSystems()
end


---@param self script.game
---@param dt number
function update(self, dt)
	self.world:update(dt)
end


function fixed_update(self, dt)
	self.world:fixed_update(dt)
end


---@param self script.game
---@param action_id hash
---@param action table
function on_input(self, action_id, action)
	return input_command.on_input(action_id, action)
end
