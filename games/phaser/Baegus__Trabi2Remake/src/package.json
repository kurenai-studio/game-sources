{
    "name": "trabi2-remake",
    "version": "1.0.0",
    "description": "A Phaser 3 remake of Trabi 2",
    "browserslist": "> 0.25%, last 2 versions, not dead",
    "targets": {
        "public": {
            "distDir": "dist",
            "publicUrl": "./",
            "source": [
                "src/pug/game.pug"
            ]
        }
    },
    "scripts": {
       "dev": "node ./parcel/runDev.mjs",
		"debug": "node ./parcel/runDev.mjs --debug",
        "prebuild": "node ./parcel/runPrebuild.mjs",
        "build": "parcel build --no-source-maps --log-level error --config ./parcel/.parcel.prod"
    },
    "author": "Baegus",
    "devDependencies": {
        "@parcel/transformer-glsl": "^2.15.2",
        "@parcel/transformer-pug": "^2.15.2",
        "@parcel/transformer-sass": "^2.15.2",
        "express": "^4.19.2",
        "parcel": "^2.15.2",
        "parcel-reporter-clean-dist": "^1.0.4",
        "parcel-reporter-static-files-copy": "^1.5.3",
        "parcel-resolver-ignore": "^2.2.0",
        "process": "^0.11.10",
        "svgo": "^3.3.2"
    },
    "dependencies": {
        "phaser": "^3.90.0",
        "phaser-box2d": "^1.1.0"
    },
    "staticFiles": {
        "staticPath": "static"
    }
}
