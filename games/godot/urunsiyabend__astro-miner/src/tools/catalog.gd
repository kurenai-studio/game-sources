extends SceneTree

## The level catalogue: every campaign dig with a number for how hard it is, measured the same
## way every time, so tuning is done from one table (docs/design/level-catalog.md, and
## data/level_catalog.json for tools). Re-run after any level or rule change:
##   godot --headless --path . -s res://tools/catalog.gd -- [runs]
##
## Per dig, with the buildings a player has there and no boosters (GDD v4 §3):
##   clear      first-attempt clear rate of the SLOPPY bot (the planner wasting 12% of its moves:
##              the human proxy) over `runs` fixed seeds
##   difficulty 0-100: 100 x (1 - clear). The one number to sort and compare by
##   attempts   expected tries to clear it, 1 / clear (Royal Match: ~1.2 normal, ~1.6 hard, ≤2.5
##              super-hard)
##   used/left  median moves a win takes / has left (length; "few left" = tension)
##   minutes    rough play time of one win: used x 3 s (move, look, animation)
##   target     the tier's clear rate (tools/tune_v4.gd); off = |clear - target| > 0.1
## Hand-made lessons are rated by their recorded solution instead: the bots cannot read Mira's
## hints, so their rate says nothing about a person.

const TUNE := preload("res://tools/tune_v4.gd")
const LevelsTool := preload("res://tools/levels.gd")
const SECONDS_PER_MOVE := 3.0


func _initialize() -> void:
	var runs := 40
	for a in OS.get_cmdline_user_args():
		if a.is_valid_int():
			runs = int(a)
	var rows := []
	for i in Sites.count():
		var site: Dictionary = Sites.get_site(i)
		var tier: String = "lesson" if site.has("ore") else ("gold rush" if site.get("gold_rush", false) else String(site.get("tier", "normal")))
		var row := {"index": i, "dig": Sites.dig_number(i), "id": site.id, "tier": tier,
				"mode": String(site.get("mode", "robot")), "colours": int(site.get("colours", 3)),
				"budget": int(site.get("energy", 20)), "goals": _goals(site)}
		if tier == "lesson":
			row.difficulty = -1
		elif tier == "gold rush":
			row.difficulty = 0
		else:
			var r := _measure(site, Economy.rules(LevelsTool.campaign_levels(i)), runs)
			var target: float = TUNE.TARGET.get(tier, 0.82)
			row.clear = snappedf(r.rate, 0.01)
			row.difficulty = int(round(100.0 * (1.0 - r.rate)))
			row.attempts = snappedf(1.0 / maxf(0.02, r.rate), 0.01)
			row.used = r.used
			row.left = r.left
			row.minutes = snappedf(r.used * SECONDS_PER_MOVE / 60.0, 0.1)
			row.target = target
			row.off = absf(r.rate - target) > 0.1
		rows.append(row)
		print("%2d %-9s %-9s d%3s" % [i, site.id, tier, str(row.difficulty)])
	_write_md(rows, runs)
	_write_json(rows)
	quit(0)


func _measure(site: Dictionary, rules: Dictionary, runs: int) -> Dictionary:
	var wins := 0
	var used := []
	var left := []
	for k in runs:
		var m := Bots.play(site, rules, 5000 + k * 41, Bots.Kind.SLOPPY)
		if m.complete:
			wins += 1
			used.append(m.moves + m.drills)
			left.append(m.energy_left)
	used.sort()
	left.sort()
	return {"rate": float(wins) / runs, "used": used[used.size() / 2] if not used.is_empty() else 0,
			"left": left[left.size() / 2] if not left.is_empty() else 0}


func _goals(site: Dictionary) -> String:
	var out := []
	for g in site.goals:
		match g.type:
			"ore": out.append("%d %s" % [g.n, Economy.RES_NAMES[g.ore]])
			"chunks": out.append("%d gems" % g.n)
			"rock": out.append("break %d" % g.n)
			"crystal": out.append("%d crystal" % g.n)
			"blast": out.append("%d blasts" % g.n)
			"treasure": out.append("%d chests" % g.n)
	return " + ".join(out)


func _write_md(rows: Array, runs: int) -> void:
	var lines := ["# Level catalogue", "",
		"GENERATED by `tools/catalog.gd` (%d SLOPPY-bot runs per dig, no boosters). Do not edit by" % runs,
		"hand: change the dig in `scripts/core/Sites.gd`, re-tune, re-run. **difficulty** = 100 x (1 -",
		"first-attempt clear rate), 0 trivial, 100 impossible; **attempts** = expected tries; **⚠**",
		"= more than 10 points off its tier's target. Lessons are rated by their recorded solution.", "",
		"| # | dig | id | mode | col | tier | goals | budget | clear | difficulty | attempts | used | left | min | |",
		"|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
	for r in rows:
		if r.difficulty < 0 or r.tier == "gold rush":
			lines.append("| %d | %s | %s | %s | %d | %s | %s | %d | – | – | – | – | – | – | |" % [
				r.index, str(r.dig) if r.dig > 0 else "–", r.id, r.mode, r.colours, r.tier, r.goals, r.budget])
			continue
		lines.append("| %d | %d | %s | %s | %d | %s | %s | %d | %d%% | **%d** | %.2f | %d | %d | %.1f | %s |" % [
			r.index, r.dig, r.id, r.mode, r.colours, r.tier, r.goals, r.budget, int(r.clear * 100),
			r.difficulty, r.attempts, r.used, r.left, r.minutes, "⚠" if r.off else ""])
	var f := FileAccess.open("res://docs/design/level-catalog.md", FileAccess.WRITE)
	f.store_string("\n".join(lines) + "\n")


func _write_json(rows: Array) -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://data"))
	var f := FileAccess.open("res://data/level_catalog.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(rows, "\t"))
