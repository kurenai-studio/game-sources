[resource]
script = ExtResource("2_d35ok")
id = &"ato2_8"
title = "O Concílio Reunido"
summary = "Sete líderes e você, no Vale do Centro. O Cinzento revela: a guerra não existe — existe apenas o Véu. Os líderes veem as memórias uns dos outros."
