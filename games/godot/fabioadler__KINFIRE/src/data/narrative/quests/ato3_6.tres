[sub_resource type="Resource" id="Resource_wa5xp"]
script = ExtResource("3_fn143")
description = "A Pena toca a cinza — e a cinza levanta voo: milhares de pássaros de luz subindo em espiral. A Chama do Vento acende prateada como gargalhada. Conta ao mundo que o vento voltou."
objectives = Array[ExtResource("4_xusdw")]([SubResource("Resource_vinau")])

