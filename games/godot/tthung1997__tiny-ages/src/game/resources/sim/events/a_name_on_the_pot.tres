[resource]
script = ExtResource("4_at0mq")
id = &"a_name_on_the_pot"
title = "A name on the pot"
body = "A pot has been carried off by the wrong family twice this month, with real conviction both times."
category = &"settlement"
requires = Array[ExtResource("3_hiejr")]([SubResource("Resource_nhp7m"), SubResource("Resource_ta1at"), SubResource("Resource_8k6py")])
