{
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/entities",
        "${workspaceFolder}/src/systems",
        "${workspaceFolder}/src/utils",
        "C:/raylib/raylib/src",
        "C:/raylib/raylib/src/external"
    ],
    "C_Cpp.default.defines": [
        "_DEBUG",
        "PLATFORM_DESKTOP"
    ],
    "C_Cpp.default.compilerPath": "C:/raylib/w64devkit/bin/g++.exe",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++14",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "iostream": "cpp",
        "vector": "cpp",
        "string": "cpp",
        "memory": "cpp",
        "functional": "cpp",
        "map": "cpp",
        "unordered_map": "cpp",
        "random": "cpp"
    },
    "C_Cpp.errorSquiggles": "enabled",
    "editor.formatOnSave": false,
    "files.exclude": {
        "**/*.o": true,
        "**/*.exe": false,
        "**/*.dll": false
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell"
}