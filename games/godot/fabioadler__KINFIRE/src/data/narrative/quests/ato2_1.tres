text = "Traga a prova aos dois líderes"

[sub_resource type="Resource" id="Resource_cnw2k"]
script = ExtResource("4_roof0")
type = 0
target = &"any:capital_*_lider"
text = "Ouça a outra versão da mesma memória"

[sub_resource type="Resource" id="Resource_j1nli"]
script = ExtResource("3_1klw6")
description = "O tratado foi assinado com o sangue de AMBOS. O Véu fez cada lado ver só o próprio sangue. O ódio era auto-infligido."
objectives = Array[ExtResource("4_roof0")]([SubResource("Resource_06pgm"), SubResource("Resource_cnw2k")])

[resource]
script = ExtResource("2_7o71c")
id = &"ato2_1"
title = "O Espelho Quebrado"
summary = "O Espelho de Miragem guarda a memória real do tratado entre humanos e alto-elfos. Cada lado jura que o outro assinou com sangue traidor — o espelho diz o contrário."
act = 2
quest_level = 8
prerequisites = Array[StringName]([&"ato1_7"])
stages = Array[ExtResource("3_1klw6")]([SubResource("Resource_roof0"), SubResource("Resource_564eh"), SubResource("Resource_j1nli")])
rewards = SubResource("Resource_pd1tk")
next = &"ato2_2"
