function on_message(self, message_id, message, sender)
	if message_id == hash("get_random_cards") then
		local nr = message.max - message.hand_size
		while nr > 0 do
			local index = math.random(1, table_size(self.deck))
			local card = table.remove(self.deck, index)
			msg.post("hand", "give_card", {card=card})
			nr = nr - 1
		end
	end
	if message_id == hash("get_one_random_card") then
		local index = math.random(1, table_size(self.deck))
		local card = table.remove(self.deck, index)
		msg.post("hand", "give_card", {card=card})
	end
end

