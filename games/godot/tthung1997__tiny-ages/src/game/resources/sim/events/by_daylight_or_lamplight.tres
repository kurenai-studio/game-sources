[sub_resource type="Resource" id="Resource_m6s3k"]
script = ExtResource("2_54pwx")
kind = 1
key = &"lamplight_meetings"

[sub_resource type="Resource" id="Resource_gn55b"]
script = ExtResource("2_54pwx")
text = "The council met by lamplight, with the day's work done, and a good many people arrived with their dinners, and the meetings ran long and warm."

[sub_resource type="Resource" id="Resource_01x2p"]
