<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <!-- Single source of truth for the release version: the release workflow
         checks that a pushed v* tag matches this before publishing builds. -->
    <Version>1.0.0</Version>
    <!-- Release builds embed the debug symbols inside Breakout.dll instead of
         emitting a loose .pdb: published/release folders ship no symbol file,
         yet crash stack traces still carry file:line information. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- The SDK's default glob compiles every .cs under this directory,
         which would pull the test project's files into the game. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Levels load at runtime via TitleContainer, not the Content Pipeline,
         so the pipeline won't copy them — we must do it ourselves. -->
    <None Include="Content\Levels\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>