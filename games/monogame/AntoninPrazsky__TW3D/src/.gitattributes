# Store text files with LF, check out with the platform's line endings
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.slnx    text
*.lev     text
*.md      text
*.obj     text
*.mtl     text
*.mgcb    text

# Binary data
*.xnb     binary
*.png     binary
*.jpg     binary
*.ico     binary
*.bmp     binary
*.pdf     binary
*.rar     binary
*.zip     binary
*.wings   binary
