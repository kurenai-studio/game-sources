{
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/entities",
                "${workspaceFolder}/src/systems", 
                "${workspaceFolder}/src/utils",
                "C:/raylib/raylib/src",
                "C:/raylib/raylib/src/external"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "PLATFORM_DESKTOP"
            ],
            "windowsSdkVersion": "10.0.19041.0",
            "compilerPath": "C:/raylib/w64devkit/bin/g++.exe",
            "cStandard": "c11",
            "cppStandard": "c++14",
            "intelliSenseMode": "windows-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "C:/raylib/raylib/src"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
