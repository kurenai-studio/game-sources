[sub_resource type="Resource" id="Resource_6vqwb"]
script = ExtResource("3_qdg4r")
description = "Sylvaris ajoelha — não de derrota, mas de lembrança. 'Eu regava as flores com as mãos', ela diz, e a Chama da Raiz acende verde como primeira chuva. Conte a alguém que ainda chore."
objectives = Array[ExtResource("4_vsmtu")]([SubResource("Resource_g385v")])

[resource]
script = ExtResource("2_hiot4")
id = &"ato3_1"
title = "O Coração que Bate na Terra"
summary = "Raízes do Mundo: a Chama da Raiz apagou e Sylvaris, a Guardiã, virou demônio por Esquecimento. Derrotá-la não é matar — é deixá-la lembrar quem era."
act = 3
quest_level = 16
prerequisites = Array[StringName]([&"ato2_8"])
stages = Array[ExtResource("3_qdg4r")]([SubResource("Resource_sr6bo"), SubResource("Resource_6vqwb")])
rewards = SubResource("Resource_85l38")
next = &"ato3_2"
