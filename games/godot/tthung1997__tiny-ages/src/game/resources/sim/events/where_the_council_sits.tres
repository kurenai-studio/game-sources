text = "The Square"

[sub_resource type="Resource" id="Resource_fh8rh"]
script = ExtResource("2_g62cp")
text = "The meetings were opened to anyone who came, and the first one was so crowded that the roof of a nearby house was used as a gallery."

[sub_resource type="Resource" id="Resource_3an1g"]
