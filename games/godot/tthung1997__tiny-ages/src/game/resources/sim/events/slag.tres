[sub_resource type="Resource" id="Resource_c2gel"]
script = ExtResource("2_momsr")
kind = 1
key = &"slag_lane"

[sub_resource type="Resource" id="Resource_acqjs"]
script = ExtResource("2_momsr")
text = "The lane was paved with crushed slag, and glittered after rain, and was slippery in exactly the places nobody expected."

[sub_resource type="Resource" id="Resource_ct3wx"]
script = ExtResource("1_283k2")
id = &"pave_the_lane_with_it"
label = "Pave the lane with it"
effects = Array[ExtResource("2_momsr")]([SubResource("Resource_c2gel"), SubResource("Resource_acqjs")])

[sub_resource type="Resource" id="Resource_3n7nw"]
script = ExtResource("2_momsr")
kind = 1
key = &"slag_heaped"

[sub_resource type="Resource" id="Resource_35gn2"]
script = ExtResource("2_momsr")
text = "The slag was heaped behind the furnace, and grew, and became a place where the children went to be dramatic."

[sub_resource type="Resource" id="Resource_ak7je"]
script = ExtResource("1_283k2")
id = &"heap_it_behind"
label = "Heap it behind the furnace, and let it grow"
effects = Array[ExtResource("2_momsr")]([SubResource("Resource_3n7nw"), SubResource("Resource_35gn2")])

[sub_resource type="Resource" id="Resource_5rcbf"]
