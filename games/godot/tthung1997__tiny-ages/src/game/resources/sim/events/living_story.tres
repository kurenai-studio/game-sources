[sub_resource type="Resource" id="Resource_sqn5h"]
script = ExtResource("2_xg45b")
kind = 1
key = &"fixed_tale"

[sub_resource type="Resource" id="Resource_wecjb"]
script = ExtResource("2_xg45b")
text = "They argued until it had one shape, and from then on it was told the same way every night."

[sub_resource type="Resource" id="Resource_mndir"]
script = ExtResource("1_ufc7j")
id = &"one_telling"
label = "Agree on one way to tell it"
effects = Array[ExtResource("2_xg45b")]([SubResource("Resource_sqn5h"), SubResource("Resource_wecjb")])

[sub_resource type="Resource" id="Resource_u0pi7"]
script = ExtResource("2_xg45b")
kind = 1
key = &"living_tale"

[sub_resource type="Resource" id="Resource_3nqbh"]
script = ExtResource("2_xg45b")
text = "The story grew a new piece every night, and someone swore it had always had a giant bird in it."

[sub_resource type="Resource" id="Resource_yns3q"]
script = ExtResource("1_ufc7j")
id = &"let_it_change"
label = "Let it change with every telling"
effects = Array[ExtResource("2_xg45b")]([SubResource("Resource_u0pi7"), SubResource("Resource_3nqbh")])

[sub_resource type="Resource" id="Resource_bnwub"]
