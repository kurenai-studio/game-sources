[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 1280
height = 720

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.001

[html5]
scale_mode = stretch

[project]
title = UltiFight Remake
version = 1.1
developer = TheSardunya

[sprite]
subpixels = 0

[windows]
app_icon = /assets/UltiFight.ico

[particle_fx]
max_count = 1024
max_emitter_count = 1024

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

