[sub_resource type="Resource" id="Resource_a6enx"]
script = ExtResource("2_1h4mm")
kind = 1
key = &"evening_tales"

[sub_resource type="Resource" id="Resource_c3l7g"]
script = ExtResource("2_1h4mm")
text = "Each person told one story in turn round the hearth, and the oldest ones had never been told aloud before."

[sub_resource type="Resource" id="Resource_uamrp"]
script = ExtResource("1_bvyst")
id = &"tell_in_turns"
label = "Tell a story each, in turns, round the hearth"
effects = Array[ExtResource("2_1h4mm")]([SubResource("Resource_a6enx"), SubResource("Resource_c3l7g")])

[sub_resource type="Resource" id="Resource_jvklj"]
script = ExtResource("2_1h4mm")
kind = 1
key = &"evening_work"

[sub_resource type="Resource" id="Resource_fa1wv"]
script = ExtResource("2_1h4mm")
text = "Everyone brought their mending to the fire, and the talk went along with the needles."

[sub_resource type="Resource" id="Resource_ayue2"]
script = ExtResource("1_bvyst")
id = &"work_by_the_fire"
label = "Bring the mending to the fire and work together"
effects = Array[ExtResource("2_1h4mm")]([SubResource("Resource_jvklj"), SubResource("Resource_fa1wv")])

[sub_resource type="Resource" id="Resource_yao7s"]
