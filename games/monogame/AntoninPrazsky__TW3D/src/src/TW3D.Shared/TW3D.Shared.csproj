<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Data shared by the game, the level editor and the tools: the catalog of track blocks
    and dynamic objects (content/catalog.json), the level file format and the collision
    shapes of the models (content/collision.json).
    Deliberately independent of MonoGame.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TW3D.Shared</RootNamespace>
    <AssemblyName>TW3D.Shared</AssemblyName>
  </PropertyGroup>

</Project>
