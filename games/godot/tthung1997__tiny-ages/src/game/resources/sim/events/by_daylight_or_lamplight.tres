[sub_resource type="Resource" id="Resource_bjtq6"]
script = ExtResource("2_54pwx")
kind = 1
key = &"daylight_meetings"

[sub_resource type="Resource" id="Resource_afg5r"]
script = ExtResource("2_54pwx")
text = "The council kept to daylight, when the square was full, and decisions were made in the presence of a great many onlookers, who sometimes helped."

[sub_resource type="Resource" id="Resource_x7qvo"]
script = ExtResource("1_0ueey")
id = &"meet_by_daylight"
label = "Meet by daylight, when the square is full"
effects = Array[ExtResource("2_54pwx")]([SubResource("Resource_bjtq6"), SubResource("Resource_afg5r")])

[sub_resource type="Resource" id="Resource_87ex5"]
