---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';

// ROADMAP.md in the repository, unchanged.
const doc = (await getEntry('docs', 'roadmap'))!;
const { Content } = await render(doc);
---

<Page title={doc.data.title} description="What's planned for SPPPD, and what isn't.">
  <div class="prose"><Content /></div>
</Page>
