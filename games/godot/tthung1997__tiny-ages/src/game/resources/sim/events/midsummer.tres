[resource]
script = ExtResource("4_2apio")
id = &"midsummer"
title = "The longest day"
body = "The sun has barely set, and someone has pointed out that tomorrow it will rise nearly where it set."
category = &"settlement"
requires = Array[ExtResource("3_ip72m")]([SubResource("Resource_2n1jn"), SubResource("Resource_6o0u2"), SubResource("Resource_8do1l")])
