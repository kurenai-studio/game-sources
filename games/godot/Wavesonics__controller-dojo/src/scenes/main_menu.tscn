[sub_resource type="Theme" id="Theme_main_menu"]
Button/colors/font_color = Color(0.921569, 0.933333, 0.960784, 1)
Button/colors/font_focus_color = Color(1, 1, 1, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
