[gd_resource type="Resource" script_class="DialogueData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/data/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_veu"]
script = ExtResource("3_choice")
text = "Fale-me sobre Kinfire"
next_id = &"kinfire_hint"
effects = "guardiao_knowledge +1"

[sub_resource type="Resource" id="Choice_prox"]
script = ExtResource("3_choice")
text = "Qual é a próxima chama?"
next_id = &"goodbye"

[sub_resource type="Resource" id="Node_intro"]
script = ExtResource("2_node")
id = &"intro"
pages = PackedStringArray("Você é de Kinfire? Sim... a magia sussurrava seu nome antes mesmo de você nascer.", "Guardiã da Floresta Crepúsculo. Eu guardo a Chama que o Sussurro tentou apagar.")
choices = Array[ExtResource("3_choice")]([SubResource("Choice_veu"), SubResource("Choice_prox")])

[sub_resource type="Resource" id="Node_kinfire_hint"]
script = ExtResource("2_node")
id = &"kinfire_hint"
pages = PackedStringArray("Kinfire queimava com sete chamas — uma por cada guardião. Quando Maldrach se tornou o Véu, a primeira chama caiu. As outras... a gente guarda.")
choices = Array[ExtResource("3_choice")]([SubResource("Choice_prox")])

[sub_resource type="Resource" id="Node_fragment"]
script = ExtResource("2_node")
id = &"fragment"
pages = PackedStringArray("Este Fragmento é a Chama que o Sussurro tentou apagar. Não é ouro nem pedra — é fogo puro, cristalizado na memória.")
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Node_goodbye"]
script = ExtResource("2_node")
id = &"goodbye"
pages = PackedStringArray("Cinco guardiões mais. O sétimo espera além da lava. E então... então você encontrará o oitavo em cinzas.")
choices = Array[ExtResource("3_choice")]([])

[resource]
script = ExtResource("1_script")
id = &"ashara_sussurra_magia"
display_name = "Ashara"
portrait = "mage_f"
start_id = &"intro"
nodes = Array[ExtResource("2_node")]([SubResource("Node_intro"), SubResource("Node_kinfire_hint"), SubResource("Node_fragment"), SubResource("Node_goodbye")])
