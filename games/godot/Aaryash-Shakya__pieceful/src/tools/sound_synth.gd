extends RefCounted
## Renders the four snap sounds from fixed recipes, so the committed WAV files can be regenerated byte for byte.

const MIX_RATE := 44100
const MASTER_GAIN := 1.5
const ATTACK := 0.001
const DECAY_FLOOR := 0.0001
const NOISE_SEED := 1

const SOUNDS := [&"pick", &"join", &"lock", &"complete"]

enum Wave { SINE, TRIANGLE }

const _TONE := &"tone"
const _CLICK := &"click"


static func render(sound: StringName) -> AudioStreamWAV:
	var components := _recipe(sound)
	var seconds := 0.0
	for c: Dictionary in components:
		seconds = maxf(seconds, c.start + c.length)
	var frames := roundi(seconds * MIX_RATE)
	var mix := PackedFloat32Array()
	mix.resize(frames)
	for c: Dictionary in components:
		if c.kind == _TONE:
			_add_tone(mix, c)
		else:
			_add_click(mix, c)

	var data := PackedByteArray()
	data.resize(frames * 2)
	for i in frames:
		data.encode_s16(2 * i, roundi(clampf(mix[i] * MASTER_GAIN, -1.0, 1.0) * 32767.0))

	var stream := AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.stereo = false
	stream.mix_rate = MIX_RATE
	stream.loop_mode = AudioStreamWAV.LOOP_DISABLED
	stream.data = data
	return stream


static func _tone(wave: Wave, f0: float, f1: float, start: float, length: float, volume: float) -> Dictionary:
	return {kind = _TONE, wave = wave, f0 = f0, f1 = f1, start = start, length = length, volume = volume}


static func _click(start: float, length: float, volume: float) -> Dictionary:
	return {kind = _CLICK, start = start, length = length, volume = volume}


static func _recipe(sound: StringName) -> Array[Dictionary]:
	match sound:
		&"pick":
			return [_tone(Wave.TRIANGLE, 320.0, 260.0, 0.0, 0.05, 0.05)]
		&"join":
			return [
				_tone(Wave.TRIANGLE, 640.0, 470.0, 0.0, 0.07, 0.14),
				_click(0.0, 0.03, 0.08),
			]
		&"lock":
			return [
				_tone(Wave.SINE, 230.0, 120.0, 0.0, 0.12, 0.3),
				_tone(Wave.TRIANGLE, 900.0, 640.0, 0.01, 0.1, 0.12),
				_click(0.0, 0.05, 0.18),
			]
		&"complete":
			var chord: Array[Dictionary] = []
			var pitches := [523.0, 659.0, 784.0, 1047.0]
			for i in pitches.size():
				chord.append(_tone(Wave.SINE, pitches[i], pitches[i], 0.11 * i, 0.6, 0.14))
			return chord
	push_error("sound_synth: unknown sound %s" % sound)
	return []


static func _add_tone(mix: PackedFloat32Array, c: Dictionary) -> void:
	var first := roundi(c.start * MIX_RATE)
	var count := roundi(c.length * MIX_RATE)
	var phase := 0.0
	for k in count:
		if first + k >= mix.size():
			break
		var t := float(k) / MIX_RATE
		var freq: float = c.f0 * pow(c.f1 / c.f0, t / c.length)
		var gain: float
		if t < ATTACK:
			gain = c.volume * t / ATTACK
		else:
			gain = c.volume * pow(DECAY_FLOOR / c.volume, (t - ATTACK) / (c.length - ATTACK))
		var wave_value: float
		if c.wave == Wave.SINE:
			wave_value = sin(TAU * phase)
		else:
			wave_value = 1.0 - 4.0 * absf(fposmod(phase + 0.25, 1.0) - 0.5)
		mix[first + k] += wave_value * gain
		phase += freq / MIX_RATE


static func _add_click(mix: PackedFloat32Array, c: Dictionary) -> void:
	var first := roundi(c.start * MIX_RATE)
	var n := roundi(c.length * MIX_RATE)
	# A fresh generator per click keeps every click identical and independent of render order.
	var rng := SeededRng.new(NOISE_SEED)
	for k in n:
		if first + k >= mix.size():
			break
		mix[first + k] += (rng.next_float() * 2.0 - 1.0) * pow(1.0 - float(k) / n, 3.0) * c.volume
