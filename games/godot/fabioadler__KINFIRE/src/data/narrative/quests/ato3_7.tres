[sub_resource type="Resource" id="Resource_vp0an"]
script = ExtResource("3_3m7l3")
description = "Xal'atath aceita a Espinha e chora — a primeira lágrima de sombra que ilumina. A Chama da Sombra acende AZUL, e quem passa por perto não sente calor: sente ser perdoado. Falta uma só."
objectives = Array[ExtResource("4_planb")]([SubResource("Resource_kwtsj")])

[resource]
script = ExtResource("2_p3eq3")
