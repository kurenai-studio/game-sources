; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BladeOrbit"
run/main_scene="uid://cr0jatvxrbsxa"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.14117648, 0.14117648, 0.14117648, 0)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://h823hs4b68e3"
general/default_playback_type=1

[autoload]

SoundManager="*uid://cs1fvt2abe3j4"
Config="*res://Autoload/Config.gd"
GameManager="*uid://b1cekilll2o8l"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/resizable=false
window/size/transparent=true
window/size/extend_to_title=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
display_server/driver.linuxbsd="wayland"

[dotnet]

project/assembly_name="Fight"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

[global_group]

player=""
map_moving=""

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
viewport/transparent_background=true
