{
  "name": "@algomind/api",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "description": "Algomind API: authentication, levels, campaign, publishing (NestJS, Prisma, PostgreSQL).",
  "scripts": {
    "generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "dev": "sh scripts/dev.sh",
    "build": "pnpm contract && pnpm generate && swc src -d dist --strip-leading-paths --config-file .swcrc",
    "start": "node dist/main.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "pnpm contract && pnpm generate && tsc --noEmit",
    "contract": "pnpm --filter @algomind/level-contract build",
    "test": "pnpm contract && pnpm generate && vitest run"
  },
  "dependencies": {
    "@algomind/level-contract": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
