[sub_resource type="Resource" id="Resource_gfog5"]
script = ExtResource("2_eccq8")
text = "A scarecrow went up in an old tunic. The birds were wary for two days, then sat on its head."

[sub_resource type="Resource" id="Resource_n58bu"]
