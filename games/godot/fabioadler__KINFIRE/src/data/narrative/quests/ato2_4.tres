text = "Traga a prova aos dois líderes"

[sub_resource type="Resource" id="Resource_jv4os"]
script = ExtResource("4_sfnc2")
type = 0
target = &"any:capital_*_lider"
text = "Ouça a outra versão da mesma memória"

[sub_resource type="Resource" id="Resource_a1e24"]
script = ExtResource("3_awscc")
description = "Meio-elfos não são híbridos. São filhos de laços que o Véu NÃO conseguiu quebrar. Cada meio-elfo é uma vitória contra o Véu."
objectives = Array[ExtResource("4_sfnc2")]([SubResource("Resource_5of1b"), SubResource("Resource_jv4os")])

[resource]
script = ExtResource("2_ksa53")
id = &"ato2_4"
title = "O Vento que Carrega Nomes"
summary = "A Pena de Águia-Celeste precisa chegar à Ponte-dos-Mundos. No caminho, o vento sopra nomes de casamentos mistos que alguém apagou dos registros."
act = 2
quest_level = 11
stages = Array[ExtResource("3_awscc")]([SubResource("Resource_sfnc2"), SubResource("Resource_fn8rc"), SubResource("Resource_a1e24")])
