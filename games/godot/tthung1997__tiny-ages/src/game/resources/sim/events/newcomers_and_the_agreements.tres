[sub_resource type="Resource" id="Resource_1a587"]
script = ExtResource("2_6a4vi")
kind = 1
key = &"read_at_the_gate"

[sub_resource type="Resource" id="Resource_j7acl"]
script = ExtResource("2_6a4vi")
text = "The town's words were read to every newcomer at the gate, in a voice that grew weary and warm, and the newcomers listened with great seriousness."

[sub_resource type="Resource" id="Resource_5jijy"]
script = ExtResource("1_bd5g5")
id = &"read_them_at_the_gate"
label = "Read the town's words to them at the gate"
effects = Array[ExtResource("2_6a4vi")]([SubResource("Resource_1a587"), SubResource("Resource_j7acl")])

[sub_resource type="Resource" id="Resource_8qdxi"]
script = ExtResource("2_6a4vi")
kind = 1
key = &"neighbour_guides"

[sub_resource type="Resource" id="Resource_ad7vk"]
script = ExtResource("2_6a4vi")
text = "Every newcomer was given a neighbour, who explained the laws at some length and with some editing, and the neighbours became fast friends."

[sub_resource type="Resource" id="Resource_1swjj"]
script = ExtResource("1_bd5g5")
id = &"give_them_a_neighbour"
label = "Give each newcomer a neighbour to explain it"
effects = Array[ExtResource("2_6a4vi")]([SubResource("Resource_8qdxi"), SubResource("Resource_ad7vk")])

