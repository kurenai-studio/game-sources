[sub_resource type="Resource" id="Resource_68ywm"]
script = ExtResource("3_0yevt")
description = "Entre as duas capitas, mascarados que pregam o rótulo de maldito se alimentam da discórdia — criaturas que só existem enquanto os dois lados acreditam na briga. Afaste-as."
