text = "Maldrach, a Ausência que Anda"

[sub_resource type="Resource" id="Resource_dp8yl"]
script = ExtResource("3_67pm6")
description = "As sete Chamas religadas queimam em fila rumo à Fenda. No caminho, a maior das ausências anda: Maldrach, o primeiro a esquecer como amar, feito monstro pela própria obra."
