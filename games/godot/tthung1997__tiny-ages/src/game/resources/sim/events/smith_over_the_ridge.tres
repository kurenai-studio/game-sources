[resource]
script = ExtResource("4_4u2um")
id = &"smith_over_the_ridge"
title = "A stranger with a leather roll"
body = "A stranger has come over the ridge with a roll of tools and a great deal of interest in the green stone. Where they come from, they say, metal has been cast for years."
