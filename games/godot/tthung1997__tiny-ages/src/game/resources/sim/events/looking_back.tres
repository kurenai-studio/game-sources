[sub_resource type="Resource" id="Resource_xyujt"]
script = ExtResource("2_v0vdk")
kind = 1
key = &"cave_remembered"

[sub_resource type="Resource" id="Resource_semdv"]
script = ExtResource("2_v0vdk")
text = "A small fire was lit in the cave, and it was agreed that it would be lit again next year."

[sub_resource type="Resource" id="Resource_qle70"]
script = ExtResource("1_x6nmr")
id = &"light_the_cave"
label = "Light a fire in the cave, once every year"
effects = Array[ExtResource("2_v0vdk")]([SubResource("Resource_xyujt"), SubResource("Resource_semdv")])

[sub_resource type="Resource" id="Resource_pepsn"]
script = ExtResource("2_v0vdk")
kind = 1
key = &"cave_left_alone"

[sub_resource type="Resource" id="Resource_s75b3"]
script = ExtResource("2_v0vdk")
text = "The cave was let be, dark and dry, and there were bats in it by spring."

[sub_resource type="Resource" id="Resource_ujwyb"]
script = ExtResource("1_x6nmr")
id = &"let_it_be"
label = "Let the cave be"
effects = Array[ExtResource("2_v0vdk")]([SubResource("Resource_pepsn"), SubResource("Resource_s75b3")])

[sub_resource type="Resource" id="Resource_yhbwp"]
