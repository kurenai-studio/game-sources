#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# config/deploy.yml reads the server from .env, and Kamal reads every secret in
# .kamal/secrets on each command, including the relay's, so this needs the same file
# as bin/relay-deploy. It deploys only the website.
env_file="${SPPPD_ENV:-.env}"
[ -f "$env_file" ] || { echo "$env_file is missing. Run make deploy-relay once first." >&2; exit 1; }
set -a; . "$env_file"; set +a
: "${SPPPD_DASHBOARD_TOKEN:?is not set in $env_file. Run make deploy-relay once first.}"

# make site has written this version's download sizes; the files are on GitHub.
[ -f site/src/downloads.json ] || { echo "Run make site first." >&2; exit 1; }

exec "${KAMAL_BIN:-kamal}" deploy "$@"
