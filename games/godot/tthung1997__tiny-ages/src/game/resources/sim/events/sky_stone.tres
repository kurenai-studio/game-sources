[sub_resource type="Resource" id="Resource_8mqif"]
script = ExtResource("2_gqpqy")
kind = 1
key = &"sky_stone_kept"

[sub_resource type="Resource" id="Resource_mq7si"]
script = ExtResource("2_gqpqy")
text = "Four of them carried the black stone to the cave, and it sat by the fire like a guest."

[sub_resource type="Resource" id="Resource_w37a8"]
script = ExtResource("1_rgaop")
id = &"keep_the_sky_stone"
label = "Carry it back and keep it by the fire"
effects = Array[ExtResource("2_gqpqy")]([SubResource("Resource_8mqif"), SubResource("Resource_mq7si")])

[sub_resource type="Resource" id="Resource_rep5b"]
script = ExtResource("2_gqpqy")
kind = 1
key = &"sky_stone_marked"

[sub_resource type="Resource" id="Resource_23rvi"]
script = ExtResource("2_gqpqy")
text = "They ringed the black stone with white pebbles, and left it to the sky."

[sub_resource type="Resource" id="Resource_kio87"]
script = ExtResource("1_rgaop")
id = &"mark_the_sky_stone"
label = "Leave it where it fell, and ring it with white stones"
effects = Array[ExtResource("2_gqpqy")]([SubResource("Resource_rep5b"), SubResource("Resource_23rvi")])

[sub_resource type="Resource" id="Resource_x3588"]
