function init(self)
	gui.set_render_order(5)
end

function update(self, dt)
	if defos then
		gui.set_enabled(gui.get_node("fullscreen"), not defos.is_fullscreen())
	end
end

function on_message(self, message_id, message, sender)
end

function on_input(self, action_id, action)
	if action.pressed and action_id == hash("touch") then
		if gui.pick_node(gui.get_node("menu_box"), action.x, action.y) then
			msg.post("/title", "show")
			return true
		elseif gui.pick_node(gui.get_node("fullscreen_box"), action.x, action.y) then
			defos.set_fullscreen(true)
		end
	end
end
