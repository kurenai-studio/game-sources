[sub_resource type="Resource" id="Resource_otvsf"]
script = ExtResource("2_1kfdu")
kind = 1
key = &"guests_at_the_gate"

[sub_resource type="Resource" id="Resource_fffx6"]
script = ExtResource("2_1kfdu")
text = "Guests were received in the court inside the gate, under the old hill-fort's wall, and were visibly impressed by it, and by being offered a seat."

[sub_resource type="Resource" id="Resource_x7cvq"]
script = ExtResource("1_6tm0v")
id = &"receive_them_at_the_gate"
label = "Receive them in the court inside the gate"
effects = Array[ExtResource("2_1kfdu")]([SubResource("Resource_otvsf"), SubResource("Resource_fffx6")])

[sub_resource type="Resource" id="Resource_1xcfp"]
script = ExtResource("2_1kfdu")
kind = 1
key = &"guests_at_the_water"

[sub_resource type="Resource" id="Resource_564h4"]
script = ExtResource("2_1kfdu")
text = "Guests were received where the lane met the water, and were handed a cup before they were asked their business, which turned out to be a very good order."

[sub_resource type="Resource" id="Resource_ytbii"]
script = ExtResource("1_6tm0v")
id = &"receive_them_at_the_lane_end"
label = "Receive them at the end of the lane, by the water"
effects = Array[ExtResource("2_1kfdu")]([SubResource("Resource_1xcfp"), SubResource("Resource_564h4")])

