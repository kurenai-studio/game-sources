[resource]
script = ExtResource("4_bnl6b")
id = &"clay_hardens"
title = "Clay by the fire"
body = "{subject} left a basket smeared with river clay too close to the fire. The basket burned away, but the clay did not melt. It stood there hard and red, and rang when it was tapped."
