; Engine configuration file.
config_version=5

[application]

config/name="Lowgear"
config/description="A lofi pastel off-road drive."
config/version="0.5.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/lowgear_icon.png"
boot_splash/bg_color=Color(0.992, 0.886, 0.894, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/lowgear_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

GameState="*res://scripts/game_state.gd"
Music="*res://scripts/audio/lofi_music.gd"
Sfx="*res://scripts/audio/sfx.gd"
Net="*res://scripts/net.gd"
Updater="*res://scripts/updater.gd"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
