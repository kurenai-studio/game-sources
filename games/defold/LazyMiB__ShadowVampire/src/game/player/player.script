local platypus = require("platypus.platypus")
local state = require("main.state")
local music_const = require("game.music.music_const")

local INPUT_LEFT = hash("left")
local INPUT_RIGHT = hash("right")
local INPUT_JUMP = hash("jump")
local INPUT_PAUSE = hash("pause")
local INPUT_RETURN = hash("return")
local INPUT_ACTION = hash("action")

local ANIM_WALK = hash("walk")
local ANIM_IDLE = hash("idle")
local ANIM_JUMP = hash("jump")
local ANIM_FALL = hash("fall")

local MSG_TELEPORT = hash("teleport")
local MSG_MOVE = hash("move")
local MSG_JUMP = hash("jump")
local MSG_PAUSE = hash("pause")
local MSG_RETURN = hash("return")

local JOYSTEAK_X_THRESHOLD = 0.1
local JOYSTEAK_Y_THRESHOLD = 0.1

local JUMP_POWER = 900
local MOVE_SPEED = 300
local SPAWN_AREA = 64
local HIT_AREA = 128
local HIT_T = 1
local FIISH_AREA = 32
local CHARGER_AREA = 32
local CHARGER_VALUE = 3

local platypus_config = {
	collisions = {
		groups = {
			[hash("ground")] = platypus.DIR_ALL,
		},
		left = 56, right = 56, top = 90, bottom = 64, offset = vmath.vector3(0, 64, 0)
	},
	gravity = -1400,
}

function init(self)
	msg.post(".", "acquire_input_focus")
	self.anim = nil
	self.ground_contact = false
	self.walking = false
	self.spawn_pos = go.get_position()
	self.t_hit = 0
	self.charger_used = false
	self.platypus = platypus.create(platypus_config)
	particlefx.play("#energy")
	particlefx.play(go.get_id("spawn"))
end

local function play_animation(self, anim)
	if self.anim ~= anim then
		sprite.play_flipbook("#sprite", anim)
		self.anim = anim
	end
end

local function update_animation(self)
	if not self.platypus.has_ground_contact() then
		return
	end
	if self.walking then
		play_animation(self, ANIM_WALK)
	else
		play_animation(self, ANIM_IDLE)
	end
end

local function play_sound(id)
	if not state.get(state.key.SOUND_ENABLED) then
		return
	end
	local gain = sound.get_group_gain("sound")
	if gain ~= music_const.SOUND_GAIN then
		sound.set_group_gain("sound", music_const.SOUND_GAIN)
	end
	sound.play(id)
end

local function teleport(self)
	local length = vmath.length(go.get_position() - self.spawn_pos)
	if length > SPAWN_AREA then
		go.set_position(self.spawn_pos)
		particlefx.play("#teleport")
		self.charger_used = false
	end
end

function update(self, dt)
	self.platypus.update(dt)
	update_animation(self)
end

function fixed_update(self, dt)
	local pos = go.get_position()
	local in_spawn = false
	if vmath.length(pos - self.spawn_pos) > SPAWN_AREA then
		msg.post(go.get_id("hud"), "pause", {value = false})
		msg.post(go.get_id("hud"), "charge", {value = false})
	else
		msg.post(go.get_id("hud"), "pause", {value = true})
		msg.post(go.get_id("hud"), "charge", {value = true})
		in_spawn = true
	end
	local enemy_pos = go.get(hash("/enemy/enemy"), "position")
	if not in_spawn then
		if vmath.length(pos - enemy_pos) <= HIT_AREA then
			if self.t_hit == 0 or self.t_hit >= HIT_T then
				particlefx.play("#hit")
				msg.post(go.get_id("hud"), "decrease_energy")
				self.t_hit = 0
				msg.post(hash("/enemy/enemy"), "hit")
				play_sound("#sound_hit")
			end
			self.t_hit = self.t_hit + dt
		else
			self.t_hit = 0
		end
	end
	local finish_pos = go.get(hash("/finish"), "position")
	if vmath.length(pos - finish_pos) <= FIISH_AREA then
		msg.post("game:/go", "next_level")
	end
	if not self.charger_used then
		local charger_pos = go.get(hash("/charger"), "position")
		if vmath.length(pos - charger_pos) <= CHARGER_AREA then
			local i = 0
			while i < CHARGER_VALUE do
				msg.post(go.get_id("hud"), "increase_all")
				i = i + 1
			end
			particlefx.play("#teleport")
			play_sound("#sound_charger")
			self.charger_used = true
		end
	end
end

local function jump(self, action)
	if action.pressed then
		self.platypus.jump(JUMP_POWER)
		play_sound("#sound_jump")
	elseif action.released then
		self.platypus.abort_jump(0.5)
	end
end

local function pause(action)
	if action.pressed then
		msg.post("main:/container", "load_pause")
	end
end

local function return_to_spawn(self, action)
	if action.pressed then
		teleport(self)
		play_sound("#sound_tp_action")
	end
end

local function set_walking(self, released)
	self.walking = true
	if released then
		self.walking = false
	end
end

local function move_left(self, action)
	self.platypus.left(MOVE_SPEED)
	sprite.set_hflip("#sprite", true)
	set_walking(self, action.released)
end

local function move_right(self, action)
	self.platypus.right(MOVE_SPEED)
	sprite.set_hflip("#sprite", false)
	set_walking(self, action.released)
end

function on_message(self, message_id, message, sender)
	self.platypus.on_message(message_id, message)
	if message_id == platypus.FALLING then
		self.ground_contact = false
		play_animation(self, ANIM_FALL)
	elseif message_id == platypus.GROUND_CONTACT then
		self.ground_contact = true
		particlefx.play("#dust")
	elseif message_id == platypus.JUMP then
		self.ground_contact = false
		play_animation(self, ANIM_JUMP)
		particlefx.play("#dust")
	elseif message_id == MSG_TELEPORT then
		teleport(self)
		play_sound("#sound_tp_died")
	elseif message_id == MSG_JUMP then
		jump(self, message)
	elseif message_id == MSG_PAUSE then
		pause(message)
	elseif message_id == MSG_RETURN then
		return_to_spawn(self, message)
	elseif message_id == MSG_MOVE then
		if math.abs(message.x) > JOYSTEAK_X_THRESHOLD then
			if message.x > 0 then
				move_right(self, message)
			elseif message.x < 0 then
				move_left(self, message)
			end
		else
			set_walking(self, true)
		end
		if math.abs(message.y) > JOYSTEAK_Y_THRESHOLD then
			if message.y > 0 then
				jump(self, message)
			end
		end
	end
end

function on_input(self, action_id, action)
	if action_id == INPUT_LEFT then
		move_left(self, action)
	elseif action_id == INPUT_RIGHT then
		move_right(self, action)
	elseif action_id == INPUT_JUMP then
		jump(self, action)
	elseif action_id == INPUT_PAUSE then
		pause(action)
	elseif action_id == INPUT_RETURN then
		return_to_spawn(self, action)
	elseif action_id == INPUT_ACTION then
		--msg.post("game:/go", "next_level")
	end
end
