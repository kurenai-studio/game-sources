kind = 1
key = &"bank_left"

[sub_resource type="Resource" id="Resource_oouqd"]
script = ExtResource("2_3txkx")
text = "The flock was kept off the bank, which grew tall, and nested with larks."

[sub_resource type="Resource" id="Resource_arskm"]
script = ExtResource("1_iv1wf")
id = &"keep_the_flock_off"
label = "Keep the flock off it"
effects = Array[ExtResource("2_3txkx")]([SubResource("Resource_6k377"), SubResource("Resource_oouqd")])

