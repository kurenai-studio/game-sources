text = "Convença o líder a abrir a galeria"

[sub_resource type="Resource" id="Resource_6warp"]
script = ExtResource("3_o8nbc")
description = "Peça ao líder acesso à galeria. Sete molduras douradas, sete vazios — e nenhuma assinatura de quem raspou."
