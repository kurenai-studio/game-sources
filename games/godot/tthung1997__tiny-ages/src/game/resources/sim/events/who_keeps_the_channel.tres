[sub_resource type="Resource" id="Resource_y6vgh"]
script = ExtResource("2_6gife")
text = "A keeper was named by turns, a month each, and the channel was never clearer, and each keeper's month was remembered for its particular leaf."

[sub_resource type="Resource" id="Resource_hvigh"]
