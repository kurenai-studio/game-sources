[resource]
script = ExtResource("2_rr14i")
id = &"misterio_1"
title = "O Sussurro nos Mapas"
summary = "Um cartógrafo de Porto Franco vende um mapa errado por 1 ouro — jura que os mapas mudam sozinhos à noite. Se ele tem razão, o mundo não é fixo: é reescrito todo dia."
act = 2
quest_level = 9
chain = &"misterio"
prerequisites = Array[StringName]([&"ato1_7"])
stages = Array[ExtResource("3_q6627")]([SubResource("Resource_6m67e"), SubResource("Resource_1rk8l")])
rewards = SubResource("Resource_ghjnr")
