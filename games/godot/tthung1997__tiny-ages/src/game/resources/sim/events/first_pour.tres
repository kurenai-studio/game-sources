[resource]
script = ExtResource("4_mha4y")
id = &"first_pour"
title = "A mould in the kiln"
body = "{subject} has pressed a hollow into a block of clay and baked it hard. It is shaped, roughly, like an axe. All it needs is the green stone, made liquid."
requires = Array[ExtResource("3_7stol")]([SubResource("Resource_njgt8"), SubResource("Resource_m3bdu"), SubResource("Resource_55c5o"), SubResource("Resource_dbv8o")])
