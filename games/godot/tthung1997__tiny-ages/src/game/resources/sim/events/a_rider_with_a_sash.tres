[sub_resource type="Resource" id="Resource_qkmlk"]
script = ExtResource("2_ey6pg")
kind = 1
key = &"envoy_guided"

[sub_resource type="Resource" id="Resource_4pgib"]
script = ExtResource("2_ey6pg")
text = "A guide was sent out to meet the rider, and the two came in together, talking, and the rider's horse was given the best stall in the village."

[sub_resource type="Resource" id="Resource_ho0a1"]
script = ExtResource("1_l022a")
id = &"send_a_guide"
label = "Send a guide to meet them on the road"
effects = Array[ExtResource("2_ey6pg")]([SubResource("Resource_qkmlk"), SubResource("Resource_4pgib")])

[sub_resource type="Resource" id="Resource_j3hwy"]
script = ExtResource("2_ey6pg")
kind = 1
key = &"envoy_waited"

[sub_resource type="Resource" id="Resource_bm83v"]
script = ExtResource("2_ey6pg")
text = "The village waited at the gate, and the rider arrived a day late, and was greeted as if she had been exactly on time."

[sub_resource type="Resource" id="Resource_d8u1n"]
script = ExtResource("1_l022a")
id = &"wait_at_the_gate_for_them"
label = "Wait for them at the gate"
effects = Array[ExtResource("2_ey6pg")]([SubResource("Resource_j3hwy"), SubResource("Resource_bm83v")])

