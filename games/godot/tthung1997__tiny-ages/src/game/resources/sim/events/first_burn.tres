[sub_resource type="Resource" id="Resource_4twr3"]
script = ExtResource("2_yiaax")
kind = 10
key = &"first_bloom"
text = "The First Bloom"

[sub_resource type="Resource" id="Resource_erbmk"]
script = ExtResource("2_yiaax")
text = "The furnace was left to burn down by itself. In the morning there was a lump in the ashes, still warm, and {subject} was seen to hug it."

[sub_resource type="Resource" id="Resource_2om1b"]
script = ExtResource("1_rm6qa")
id = &"let_it_burn_down"
label = "Let it burn down on its own, and open it in the morning"
effects = Array[ExtResource("2_yiaax")]([SubResource("Resource_4f7at"), SubResource("Resource_4twr3"), SubResource("Resource_erbmk")])

