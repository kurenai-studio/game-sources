[sub_resource type="Resource" id="Resource_ypvji"]
script = ExtResource("2_4g45f")
kind = 1
key = &"mould_patched"

[sub_resource type="Resource" id="Resource_kjotd"]
script = ExtResource("2_4g45f")
text = "The crack was patched with wet clay and the mould went back to work, with a thin line down every blade like a signature."

[sub_resource type="Resource" id="Resource_l4mu5"]
script = ExtResource("1_7rau2")
id = &"patch_the_mould"
label = "Patch it with wet clay"
effects = Array[ExtResource("2_4g45f")]([SubResource("Resource_ypvji"), SubResource("Resource_kjotd")])

[sub_resource type="Resource" id="Resource_1cur3"]
script = ExtResource("2_4g45f")
kind = 1
key = &"mould_remade"

[sub_resource type="Resource" id="Resource_6wdqx"]
script = ExtResource("2_4g45f")
text = "The mould was broken with some ceremony and a new one made, a little bigger and a great deal more careful."

[sub_resource type="Resource" id="Resource_k4nwl"]
script = ExtResource("1_7rau2")
id = &"break_and_remake"
label = "Break it, and make a better one"
effects = Array[ExtResource("2_4g45f")]([SubResource("Resource_1cur3"), SubResource("Resource_6wdqx")])

