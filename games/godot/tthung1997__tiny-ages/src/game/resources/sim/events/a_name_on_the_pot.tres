key = &"knotted_marks"

[sub_resource type="Resource" id="Resource_njw2o"]
script = ExtResource("2_ay1pe")
text = "Every pot got a cord, and the cords got knots, and the knots got names."

[sub_resource type="Resource" id="Resource_7bxvi"]
script = ExtResource("1_i8pdi")
