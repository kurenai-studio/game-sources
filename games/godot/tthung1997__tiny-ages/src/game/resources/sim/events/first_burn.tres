[resource]
script = ExtResource("4_o3qkw")
id = &"first_burn"
title = "A night's burn"
body = "{subject} has packed the new furnace with red ore and charcoal in layers, and sealed the top with clay. All it wants now is the bellows, and a very long night."
requires = Array[ExtResource("3_7utdg")]([SubResource("Resource_8cswv"), SubResource("Resource_p3hoa"), SubResource("Resource_01uru"), SubResource("Resource_avd8c")])
needs_subject = true
subject_requires = Array[ExtResource("3_7utdg")]([SubResource("Resource_fof8l")])
trait_weights = Dictionary[StringName, float]({
&"curious": 3.0
})
chance_per_tick = 0.03
cooldown_ticks = 48
choices = Array[ExtResource("1_rm6qa")]([SubResource("Resource_kcwdp"), SubResource("Resource_2om1b")])
