# Apache config for the static build on the shared hosting (copied into dist/ by Vite).

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Vite names bundles by their content hash, so they can be cached for a year
    <FilesMatch "\.(js|css|woff2?)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # The page must always be fresh, otherwise it would reference a removed bundle
    <FilesMatch "^index\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
