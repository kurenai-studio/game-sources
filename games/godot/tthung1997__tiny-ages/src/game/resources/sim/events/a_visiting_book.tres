[sub_resource type="Resource" id="Resource_23uak"]
script = ExtResource("2_obote")
kind = 1
key = &"book_copied"

[sub_resource type="Resource" id="Resource_nrk5v"]
script = ExtResource("2_obote")
text = "The book was copied, page by page, by lamplight, and the copy was bound in leather and set on the shelf with great ceremony."

[sub_resource type="Resource" id="Resource_1trno"]
script = ExtResource("3_ncxgt")
kind = 2
key = &"food"
amount = 3

[sub_resource type="Resource" id="Resource_2xnor"]
script = ExtResource("1_bk71m")
id = &"copy_the_book"
label = "Copy it, page by page, before it goes on"
requires = Array[ExtResource("3_ncxgt")]([SubResource("Resource_1trno")])
effects = Array[ExtResource("2_obote")]([SubResource("Resource_own0g"), SubResource("Resource_23uak"), SubResource("Resource_nrk5v")])

[sub_resource type="Resource" id="Resource_mha1d"]
script = ExtResource("2_obote")
kind = 1
key = &"stories_bound"

[sub_resource type="Resource" id="Resource_jl5mh"]
script = ExtResource("2_obote")
text = "The town's own stories were gathered and bound, and the first reader found a story about their grandmother and had to sit down."

[sub_resource type="Resource" id="Resource_12ghu"]
script = ExtResource("1_bk71m")
id = &"gather_the_towns_stories"
label = "Gather the town's own stories instead, and bind those"
effects = Array[ExtResource("2_obote")]([SubResource("Resource_mha1d"), SubResource("Resource_jl5mh")])

