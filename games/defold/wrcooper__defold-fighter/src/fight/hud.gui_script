-- Health bars, timer, round pips, combo counters, announcements and the
-- pause overlay. Driven entirely by messages from fight.script.
local BAR_WIDTH = 500
local BAR_HEIGHT = 26

local WIN_ON = vmath.vector4(1, 0.82, 0.3, 1)
local WIN_OFF = vmath.vector4(0.25, 0.2, 0.28, 1)

local function set_bar(node, ratio)
	gui.set_size(node, vmath.vector3(BAR_WIDTH * math.max(0, ratio), BAR_HEIGHT, 0))
end

function init(self)
	self.n = {}
	for _, id in ipairs({ "timer", "announce", "sub", "pause_bg", "pause_moves", "pause_moves_title", "pause_volume" }) do
		self.n[id] = gui.get_node(id)
	end
	self.p = {}
	for i = 1, 2 do
		local p = "p" .. i
		self.p[i] = {
			bar = gui.get_node(p .. "_bar"),
			lag = gui.get_node(p .. "_bar_lag"),
			name = gui.get_node(p .. "_name"),
			combo = gui.get_node(p .. "_combo"),
			wins = { gui.get_node(p .. "_win1"), gui.get_node(p .. "_win2") },
			hp = 1, lag_hp = 1, lag_delay = 0,
		}
	end
	gui.set_text(self.n.announce, "")
	gui.set_text(self.n.sub, "")
	self.announce_t = 0
	self.box_key = {}
end

-- color key for the hitbox viewer, built from the colors fight.script sends
local function show_box_key(self, on, key)
	if on and #self.box_key == 0 then
		local x = 58
		for _, k in ipairs(key) do
			local n = gui.new_text_node(vmath.vector3(x, 595, 0), k.name)
			gui.set_font(n, "small")
			gui.set_pivot(n, gui.PIVOT_W)
			gui.set_color(n, k.color)
			self.box_key[#self.box_key + 1] = n
			x = x + #k.name * 13 + 26
		end
	end
	for _, n in ipairs(self.box_key) do gui.set_enabled(n, on) end
end

function update(self, dt)
	for _, p in ipairs(self.p) do
		if p.lag_hp > p.hp then
			if p.lag_delay > 0 then
				p.lag_delay = p.lag_delay - dt
			else
				p.lag_hp = math.max(p.hp, p.lag_hp - dt * 0.6)
			end
		else
			p.lag_hp = p.hp
		end
		set_bar(p.lag, p.lag_hp)
	end
	if self.announce_t > 0 then
		self.announce_t = self.announce_t - dt
		if self.announce_t <= 0 then
			gui.animate(self.n.announce, "color.w", 0, gui.EASING_LINEAR, 0.2)
		end
	end
end

local function announce(self, text, seconds)
	local n = self.n.announce
	gui.cancel_animations(n, "color.w")
	gui.cancel_animations(n, "scale")
	gui.set_text(n, text)
	gui.set_alpha(n, 1)
	gui.set_scale(n, vmath.vector3(2.2, 2.2, 1))
	gui.animate(n, "scale", vmath.vector3(1.4, 1.4, 1), gui.EASING_OUTBACK, 0.3)
	self.announce_t = seconds or 1
end

function on_message(self, message_id, message)
	if message_id == hash("setup") then
		gui.set_text(self.p[1].name, message.name1)
		gui.set_text(self.p[2].name, message.name2)
		gui.set_text(self.n.pause_moves, message.moves or "")
		gui.set_text(self.n.pause_moves_title, message.moves_title or "")
	elseif message_id == hash("status") then
		local hp = { message.h1, message.h2 }
		local wins = { message.w1, message.w2 }
		for i, p in ipairs(self.p) do
			if hp[i] < p.hp then p.lag_delay = 0.35 end
			if hp[i] > p.hp then p.lag_hp = hp[i] end
			p.hp = hp[i]
			set_bar(p.bar, p.hp)
			for k = 1, 2 do
				gui.set_color(p.wins[k], wins[i] >= k and WIN_ON or WIN_OFF)
			end
		end
		gui.set_text(self.n.timer, tostring(message.timer))
		gui.set_color(self.n.timer, message.timer <= 10 and vmath.vector4(1, 0.35, 0.3, 1) or vmath.vector4(1, 1, 1, 1))
	elseif message_id == hash("announce") then
		announce(self, message.text, message.seconds)
	elseif message_id == hash("sub") then
		gui.set_text(self.n.sub, message.text or "")
	elseif message_id == hash("combo") then
		local n = self.p[message.index].combo
		gui.cancel_animations(n, "color.w")
		gui.set_text(n, message.hits .. " HITS")
		gui.set_alpha(n, 1)
		gui.set_scale(n, vmath.vector3(1.3, 1.3, 1))
		gui.animate(n, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTQUAD, 0.15)
		gui.animate(n, "color.w", 0, gui.EASING_INQUAD, 0.6, 0.9)
	elseif message_id == hash("pause") then
		gui.set_enabled(self.n.pause_bg, message.on)
	elseif message_id == hash("volume_label") then
		gui.set_text(self.n.pause_volume, "[Left/Right] Volume: " .. message.label)
	elseif message_id == hash("boxes") then
		show_box_key(self, message.on, message.key)
	end
end
