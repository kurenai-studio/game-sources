[resource]
script = ExtResource("4_l37gc")
id = &"long_evenings"
title = "The long evenings"
body = "The evenings have grown long, and nobody quite knows what to do with them."
requires = Array[ExtResource("3_hviw8")]([SubResource("Resource_yao7s"), SubResource("Resource_c1jy4")])
chance_per_tick = 0.05
once = true
choices = Array[ExtResource("1_bvyst")]([SubResource("Resource_uamrp"), SubResource("Resource_ayue2")])
