[resource]
script = ExtResource("4_d0wva")
id = &"the_metals_road"
title = "The metal's road"
body = "The green stone has been in the fire so often that nobody is surprised by what comes out of it any more. The only question left is where to take it from here."
category = &"settlement"
choices = Array[ExtResource("1_vv1qv")]([SubResource("Resource_w180i"), SubResource("Resource_epvup")])
