text = "as emboscadas que a canção denunciou"

[sub_resource type="Resource" id="Resource_l2jbm"]
script = ExtResource("3_xy8og")
description = "A canção é uma cifra dos Sussurros. Salomé era espiã do Véu — e se arrependeu. Cada emboscada frustrada prova que a rotina do Véu pode ser lida."
objectives = Array[ExtResource("4_fu37l")]([SubResource("Resource_qbrah")])

[resource]
script = ExtResource("2_jpj80")
id = &"misterio_4"
title = "O Enigma de Salomé"
summary = "Uma barda chamada Salomé canta uma canção que prediz emboscadas três dias antes de acontecerem. Se a música prevê, alguém compôs — e o Véu tem rotina."
act = 2
quest_level = 12
chain = &"misterio"
prerequisites = Array[StringName]([&"ato1_4"])
stages = Array[ExtResource("3_xy8og")]([SubResource("Resource_obak8"), SubResource("Resource_l2jbm")])
rewards = SubResource("Resource_58jas")
