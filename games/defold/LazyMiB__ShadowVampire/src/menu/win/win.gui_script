local druid = require("druid.druid")
local state = require("main.state")
local anim = require("menu.anim")

local INPUT_JUMP = hash("jump")

local function resume_clicked(self)
	msg.post("main:/container", "win_resume")
	self.resume_btn:set_enabled(false)
end

function init(self)
	self.druid = druid.new(self)
	self.resume_btn = self.druid:new_button("resume", resume_clicked)
	self.resume_btn:set_key_trigger(hash("pause"))
	gui.set_text(gui.get_node("lvl"), "LVL's completed: " .. state.get(state.key.LEVEL_HUD))
	gui.set_text(gui.get_node("min"), "Took: " .. state.get(state.key.LEVEL_MIN) .. "min")
	anim.animate("blocker", anim.FAST_D)
	anim.animate("resume", anim.DEFAULT_D)
	anim.animate("desc", anim.MEDIUM_D)
	anim.animate("level", anim.FAST_D)
	local particles_node = gui.get_node("particlefx")
	gui.play_particlefx(particles_node)
end

function final(self)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	if action_id == INPUT_JUMP then
		resume_clicked(self)
	end
	return self.druid:on_input(action_id, action)
end