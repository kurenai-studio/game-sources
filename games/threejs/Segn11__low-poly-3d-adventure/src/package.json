{
  "name": "super-star-hopper",
  "version": "1.0.0",
  "description": "3D Low-Poly Platformer Adventure game built with Three.js and Vite",
  "author": "Segni Nadew",
  "repository": {
    "type": "git",
    "url": "https://github.com/Segn11/low-poly-3d-adventure.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "app:start": "npm run build && electron .",
    "app:build": "npm run build && electron-builder --publish never",
    "app:build:portable": "npm run build && electron-builder --win portable --publish never",
    "app:build:dir": "npm run build && electron-builder --dir --publish never"
  },
  "build": {
    "appId": "com.segn11.starhopper",
    "productName": "Super Star Hopper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
