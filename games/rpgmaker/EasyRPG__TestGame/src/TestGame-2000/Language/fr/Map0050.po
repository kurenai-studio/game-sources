#. ID 1, Page 1, Line 1, Pos (6,7)
msgid ""
"Flash hero 3.0 sec.\n"
"Wait to finish"
msgstr ""
"Flash du Héros pendant 3,0 secondes.\n"
"Attend de finir."

#. ID 1, Page 1, Line 4, Pos (6,7)
#. ID 2, Page 1, Line 4, Pos (6,4)
#. ID 42, Page 1, Line 6, Pos (10,11)
msgid "Finished"
msgstr "Terminé."

