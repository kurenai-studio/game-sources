; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scrap Signal"
run/main_scene="uid://do1aqgu8ljdju"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="uid://b0j6vi8mnfcuu"

[audio]

general/default_playback_type.web=0

[autoload]

GameState="*uid://dj5xpo55gtvr7"
AudioManager="*uid://dsilww05kuakm"
SceneManager="uid://cqmks3a5dsxuy"

