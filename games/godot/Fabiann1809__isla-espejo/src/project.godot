; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Isla Espejo"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_attack"
2d_physics/layer_5="enemy_attack"
2d_physics/layer_6="interactable"

[autoload]

Events="*res://scripts/core/events.gd"
PlayerProfile="*res://scripts/ai/player_profile.gd"
Director="*res://scripts/ai/director.gd"
GameState="*res://scripts/core/game_state.gd"
Settings="*res://scripts/core/settings.gd"
SaveGame="*res://scripts/core/save_game.gd"
Dialogue="*res://scripts/core/dialogue.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

