---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';

// README.md in the repository, unchanged: the controls, the cars, desktop against
// phone, online and building. Its own title is just the game's name.
const doc = (await getEntry('docs', 'readme'))!;
const { Content } = await render(doc);
---

<Page title="Guide" description="SPPPD's controls, cars, what differs on a phone, and how online works.">
  <div class="prose guide"><Content /></div>
</Page>

<style>
  /* Text keeps its reading width, and tables take the whole road, which fits the
     car table on a desktop. On a phone each table scrolls on its own. */
  .guide {
    max-width: none;
  }

  .guide > :global(:not(table)) {
    max-width: 40rem;
  }

  .guide :global(table) {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    font-size: 0.9375rem;
  }

  .guide :global(td),
  .guide :global(th) {
    white-space: nowrap;
    padding-right: 0.625rem;
  }
</style>
