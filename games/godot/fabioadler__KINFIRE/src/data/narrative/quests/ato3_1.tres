[sub_resource type="Resource" id="Resource_sr6bo"]
script = ExtResource("3_qdg4r")
description = "A corrupção tem guardiões. Pode a memória de uma floresta inteira apagar quem a guardava? Limpe o caminho até o coração que ainda bate na terra."
