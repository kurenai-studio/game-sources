[resource]
script = ExtResource("4_1yylr")
id = &"frost_in_the_furnace"
title = "Frost in the furnace"
body = "The first hard frost has come, and the furnace is cold at the edges, and iron does not like a cold furnace."
category = &"settlement"
requires = Array[ExtResource("3_xxjj2")]([SubResource("Resource_w7dal"), SubResource("Resource_vx4ow"), SubResource("Resource_t6viw"), SubResource("Resource_hcx0u")])
