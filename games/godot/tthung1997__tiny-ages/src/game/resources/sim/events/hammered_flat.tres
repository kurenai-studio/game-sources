[resource]
script = ExtResource("4_b8syr")
id = &"hammered_flat"
title = "Beaten thin as a leaf"
body = "{subject} has been beating a lump of the green stone flat on a river cobble. It does not crack. It gets as thin as a leaf, and shines."
requires = Array[ExtResource("3_hq54d")]([SubResource("Resource_40bvm"), SubResource("Resource_xpev0"), SubResource("Resource_et60r")])
