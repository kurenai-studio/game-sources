key = &"burning_days"

[sub_resource type="Resource" id="Resource_ipr2w"]
script = ExtResource("2_5ft06")
text = "Burning days became days when nobody went near the furnace who did not have to, and a sort of holiday atmosphere, with soot."

[sub_resource type="Resource" id="Resource_ny3cs"]
