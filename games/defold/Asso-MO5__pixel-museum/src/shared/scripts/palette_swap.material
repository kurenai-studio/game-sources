name: "palette_swap"
tags: "tile"
vertex_program: "/builtins/materials/sprite.vp"
fragment_program: "/shared/scripts/palette_swap.fp"
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
}
fragment_constants {
  name: "tolerance"
  type: CONSTANT_TYPE_USER
  value {
    x: 0.2
  }
}
fragment_constants {
  name: "target_color"
  type: CONSTANT_TYPE_USER
  value {
    x: 0.91
    y: 0.82
    z: 0.67
    w: 1.0
  }
}
fragment_constants {
  name: "source_color"
  type: CONSTANT_TYPE_USER
  value {
    x: 0.91
    y: 0.82
    z: 0.67
    w: 1.0
  }
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_DEFAULT
  filter_mag: FILTER_MODE_MAG_DEFAULT
  max_anisotropy: 0.0
}
