text = "Enfrente a Escolha Real com o Cinzento"

[sub_resource type="Resource" id="Resource_qvuxu"]
script = ExtResource("3_67pm6")
description = "Dentro da Fenda, a Primeira Chama espera — e o Cinzento espera com ela. Ele sabia o nome de vocês desde antes de vocês existirem. A escolha é sua: selar o mundo ou libertá-lo."
objectives = Array[ExtResource("4_xbiu3")]([SubResource("Resource_7pti0")])

[resource]
script = ExtResource("2_11h07")
id = &"ato3_8"
title = "O Fogo dos Laços"
summary = "Vale do Centro → Dentro da Fenda: as Sete Chamas religadas apontam para o oitavo fogo — a Kinfire. A Escolha Real: sem os 8 Fragmentos da Verdade, apenas o Final Cinzento; com todos, o Final Dourado se abre. Você será avisado."
act = 3
quest_level = 23
prerequisites = Array[StringName]([&"ato3_7"])
stages = Array[ExtResource("3_67pm6")]([SubResource("Resource_dp8yl"), SubResource("Resource_qvuxu")])
