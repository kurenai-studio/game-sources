[resource]
script = ExtResource("4_a2hh2")
id = &"water_by_the_carriers"
title = "Water by the carriers"
body = "The water-carriers have carried water to the town for years, and have begun to mention, in passing, how far the spring is, and how heavy a bucket is."
category = &"nature"
requires = Array[ExtResource("3_b4n4s")]([SubResource("Resource_pjt3n"), SubResource("Resource_6h72g"), SubResource("Resource_c3238"), SubResource("Resource_eclxv")])
