[resource]
script = ExtResource("4_itpaw")
id = &"a_visiting_book"
title = "A visiting book"
body = "A traveller has left a book behind, overnight, with a note asking that it be looked after, and {subject} has already read the first page and is not sleeping."
requires = Array[ExtResource("3_ncxgt")]([SubResource("Resource_lvgrc"), SubResource("Resource_m7ki4"), SubResource("Resource_n8psw")])
needs_subject = true
subject_requires = Array[ExtResource("3_ncxgt")]([SubResource("Resource_h2p1h")])
trait_weights = Dictionary[StringName, float]({
&"curious": 3.0
})
chance_per_tick = 0.05
once = true
choices = Array[ExtResource("1_bk71m")]([SubResource("Resource_2xnor"), SubResource("Resource_12ghu")])
