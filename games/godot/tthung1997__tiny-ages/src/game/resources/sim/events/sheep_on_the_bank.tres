key = &"bank_grazed"

[sub_resource type="Resource" id="Resource_g1uww"]
script = ExtResource("2_3txkx")
text = "The flock grazed the bank clean, and the bank was never so tidy, and the sheep looked like a procession."

[sub_resource type="Resource" id="Resource_027xs"]
