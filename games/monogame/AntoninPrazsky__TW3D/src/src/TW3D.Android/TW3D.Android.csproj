<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The game for Android phones: the same code as src/TW3D.Game (linked here), built for Android.
    Code that differs between the platforms is marked #if ANDROID.
    Needs the Android workload: dotnet workload install android
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>TW3D</RootNamespace>
    <AssemblyName>TW3D</AssemblyName>
    <ApplicationId>io.github.antoninprazsky.tw3d</ApplicationId>
    <ApplicationTitle>Triple Wheel 3D</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TW3D.Game\**\*.cs" Exclude="..\TW3D.Game\Program.cs;..\TW3D.Game\Editor\**;..\TW3D.Game\bin\**;..\TW3D.Game\obj\**" LinkBase="Game" />
  </ItemGroup>

  <ItemGroup>
    <!-- Models and shaders built by the content pipeline, packed in the app as Content/
         (the builds for each runtime run in parallel, so each builds into its own folder) -->
    <MonoGameContentReference Include="$(GameContentDir)Content.mgcb" Link="Content\Content.mgcb" OutputFolder="$(MSBuildProjectName)$(RuntimeIdentifier)" />
    <!-- The other shared game content (precompiled fonts, levels, the catalog), packed in the app as Content/ -->
    <AndroidAsset Include="$(GameContentDir)**\*" Exclude="$(ContentPipelineSources)" Link="Assets\Content\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Aether.Physics2D DebugView loads its font as "DiagnosticsFont" -->
    <AndroidAsset Include="..\..\content\Font.xnb" Link="Assets\Content\DiagnosticsFont.xnb" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" />
    <PackageReference Include="MonoGame.Content.Builder.Task" />
    <PackageReference Include="Aether.Physics2D.MG" />
    <!-- Its own copy of the debug view font is not used, the game content has it -->
    <PackageReference Include="Aether.Physics2D.Diagnostics.MG" ExcludeAssets="contentFiles" />
    <ProjectReference Include="..\TW3D.Shared\TW3D.Shared.csproj" />
    <!-- Built for the content pipeline, which loads it (content/Content.mgcb) -->
    <ProjectReference Include="..\..\tools\ContentPipeline\ContentPipeline.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
