[resource]
script = ExtResource("4_17iio")
id = &"living_story"
title = "The long story"
body = "The story told by the fire has grown long. Everyone has added a piece, and they no longer agree on how it goes."
requires = Array[ExtResource("3_45nes")]([SubResource("Resource_bnwub"), SubResource("Resource_tb3k0"), SubResource("Resource_8608u"), SubResource("Resource_p5ic4")])
