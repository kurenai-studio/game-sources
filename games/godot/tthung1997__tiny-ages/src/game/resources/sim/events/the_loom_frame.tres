[resource]
script = ExtResource("4_hlour")
id = &"the_loom_frame"
title = "Two posts and some thread"
body = "{subject} has propped a frame between two posts and wound thread from end to end. It might weave faster than hands alone."
requires = Array[ExtResource("3_nqxto")]([SubResource("Resource_31d3o"), SubResource("Resource_337mu"), SubResource("Resource_hxcba")])
