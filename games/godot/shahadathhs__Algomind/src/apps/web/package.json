{
  "name": "@algomind/web",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "description": "Algomind web app: the public site (download first) and the admin dashboard.",
  "scripts": {
    "dev": "pnpm contract && next dev",
    "build": "pnpm contract && node scripts/fetch-play-build.mjs && next build",
    "start": "next start",
    "typecheck": "pnpm contract && tsc --noEmit",
    "contract": "pnpm --filter @algomind/level-contract build"
  },
  "dependencies": {
    "@algomind/level-contract": "workspace:*",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3"
  }
}
