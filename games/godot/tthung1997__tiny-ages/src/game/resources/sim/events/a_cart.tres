[resource]
script = ExtResource("4_3ylw5")
id = &"a_cart"
title = "Something that rolls"
body = "{subject} has been rolling a cut section of trunk down the hill and chasing it. It occurs to {subject} that something could sit on it."
requires = Array[ExtResource("3_mocb7")]([SubResource("Resource_rmx2i"), SubResource("Resource_nyj1k"), SubResource("Resource_0cpgs")])
needs_subject = true
subject_requires = Array[ExtResource("3_mocb7")]([SubResource("Resource_wxel7")])
trait_weights = Dictionary[StringName, float]({
&"industrious": 3.0
})
chance_per_tick = 0.03
cooldown_ticks = 48
choices = Array[ExtResource("1_1ykn2")]([SubResource("Resource_2or54"), SubResource("Resource_vb3fo")])
