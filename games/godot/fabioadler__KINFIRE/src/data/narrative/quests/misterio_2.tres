[sub_resource type="Resource" id="Resource_wt5n0"]
script = ExtResource("4_jpguk")
type = 1
target = &"fantasma"
count = 5
text = "raspadores que ainda cumprem ordens antigas"

[sub_resource type="Resource" id="Resource_f7pmo"]
script = ExtResource("3_o8nbc")
description = "Os rostos eram os Sete Guardiões originais das Chamas. O Véu não começou a queda — alguém preparou o terreno. A limpeza continua: apague os apagadores."
objectives = Array[ExtResource("4_jpguk")]([SubResource("Resource_wt5n0")])

[resource]
script = ExtResource("2_bugwe")
id = &"misterio_2"
title = "Os Retratos Apagados"
summary = "Na galeria da Guilda, sete retratos com os rostos raspados. Não foram apagados depois da Queda — foram raspados ANTES de o Véu cair. Alguém sabia o que vinha."
act = 2
quest_level = 10
chain = &"misterio"
prerequisites = Array[StringName]([&"ato1_2"])
stages = Array[ExtResource("3_o8nbc")]([SubResource("Resource_6warp"), SubResource("Resource_f7pmo")])
rewards = SubResource("Resource_5xrr1")
