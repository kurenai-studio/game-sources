[node name="controls_info" type="Label" parent="Title_Options/HowToPlayPanel/VBoxContainer" unique_id=1263443676]
layout_mode = 2
text = "Movement
Mouse: Click and drag
Keyboard:  A = left, D = right
Gamepad: Joypad left or right stick
Abilities
Mouse: On screen buttons
Keyboard: Space = Axe, E = Hammer, Q = Saw
Gamepad: A = Axe, B = Hammer, X = Saw"

[node name="ablility" type="Label" parent="Title_Options/HowToPlayPanel/VBoxContainer" unique_id=1535291652]
layout_mode = 2
text = "Abilities"
horizontal_alignment = 1

[node name="abilitiy_info" type="Label" parent="Title_Options/HowToPlayPanel/VBoxContainer" unique_id=1444234358]
layout_mode = 2
text = "Axe : swings and destroys any Tree in range. Base cooldown 3.2s.   
Each tree cut refunds 0.625s off your freeze timer (heat).
Hammer: swings and destroys any Boulder or Snow Barrier in 
range. Base cooldown 3.9s. Boulders refund 1.25s of heat 
each; snow barriers refund 0.625s each.
Saw: fires a spinning blade forward that flies through trees, 
cutting up to 6 of them (grows by 1 per stack, capped at 16), 
and gets destroyed outright if it hits a Boulder. Base 
cooldown 6.5s."

[node name="combo" type="Label" parent="Title_Options/HowToPlayPanel/VBoxContainer" unique_id=903586307]
layout_mode = 2
text = "Combos"
horizontal_alignment = 1

[node name="combo_info" type="Label" parent="Title_Options/HowToPlayPanel/VBoxContainer" unique_id=1881553315]
layout_mode = 2
text = "Combo: Cut 3+ trees in one axe swing (or smash 1 boulder) 
to start it. Keep chopping/smashing to extend it before the 
shrinking timer runs out. Ends on timeout or a hit, paying up 
to 6s bonus heat."

