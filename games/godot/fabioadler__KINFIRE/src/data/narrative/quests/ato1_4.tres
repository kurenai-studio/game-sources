[sub_resource type="Resource" id="Resource_np0nx"]
script = ExtResource("4_asql3")
type = 0
target = &"any:capital_*_lider"
text = "Receba a carta do líder"

[sub_resource type="Resource" id="Resource_bi2kt"]
script = ExtResource("3_bi2kt")
description = "O líder entrega uma carta lacrada com ordens urgentes — e jura que nenhuma ordem de bloqueio saiu de sua mesa."
objectives = Array[ExtResource("4_asql3")]([SubResource("Resource_np0nx")])

[sub_resource type="Resource" id="Resource_asql3"]
script = ExtResource("4_asql3")
type = 1
target = &"orc_mascarado"
count = 3
text = "guardas de \"ordens do alto\""

[sub_resource type="Resource" id="Resource_y0rnp"]
script = ExtResource("3_bi2kt")
description = "Na fronteira, guardas de rostos vazios recitam a ordem falsificada. Quando você resiste, atacam."
objectives = Array[ExtResource("4_asql3")]([SubResource("Resource_asql3")])

[sub_resource type="Resource" id="Resource_p6plf"]
script = ExtResource("4_asql3")
type = 0
target = &"any:capital_*_lider"
text = "Entregue a carta a um líder"

[sub_resource type="Resource" id="Resource_aw13m"]
script = ExtResource("3_bi2kt")
description = "Entregue a carta a outro líder — que a leia em voz alta, para que a mentira tenha testemunha."
objectives = Array[ExtResource("4_asql3")]([SubResource("Resource_p6plf")])

[resource]
script = ExtResource("2_np0nx")
id = &"ato1_4"
title = "A Carta que Nunca Chegou"
summary = "Entregar uma carta do seu líder. Os guardas do SEU território impedem: 'Ordens do alto: ninguém sai.' Seu líder não deu essa ordem."
quest_level = 4
stages = Array[ExtResource("3_bi2kt")]([SubResource("Resource_bi2kt"), SubResource("Resource_y0rnp"), SubResource("Resource_aw13m")])
rewards = SubResource("Resource_f55l3")
next = &"ato1_5"
