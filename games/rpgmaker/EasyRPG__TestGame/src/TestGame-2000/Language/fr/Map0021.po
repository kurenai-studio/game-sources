#. ID 2, Page 1, Line 1, Pos (3,6)
msgid "Doing Full Recovery."
msgstr "Utilisation d'une commande Guérison Totale."

#. ID 3, Page 1, Line 1, Pos (6,9)
msgid ""
"Attack Brian with Atk 5\n"
"100% Def, 0% Mind\n"
"Result in Var1"
msgstr ""
"Attaque Brian avec 5 d'Attaque\n"
"100% Rés. Défense, 0% Rés. Esprit\n"
"Résultat dans la Variable 1"

#. ID 3, Page 1, Line 5, Pos (6,9)
#. ID 4, Page 1, Line 5, Pos (7,9)
#. ID 5, Page 1, Line 5, Pos (8,9)
#. ID 6, Page 1, Line 6, Pos (6,7)
