[resource]
script = ExtResource("2_0qnhd")
id = &"misterio_7"
title = "O Diário de Ithariel"
summary = "Páginas espalhadas pelas Masmorras-Chama: um diário escrito há 1.133 anos. Ithariel sabia que falharia — e escreveu para o futuro Laço-Vivo. Endereça por um nome que você ainda não tem."
