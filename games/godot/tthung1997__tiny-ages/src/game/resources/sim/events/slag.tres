[resource]
script = ExtResource("4_3etxn")
id = &"slag"
title = "Slag"
body = "Every burn leaves a heap of black glassy slag behind the furnace, and the heap is now taller than the furnace."
category = &"settlement"
requires = Array[ExtResource("3_8co6m")]([SubResource("Resource_5rcbf"), SubResource("Resource_kvvrj"), SubResource("Resource_dym00")])
chance_per_tick = 0.05
once = true
choices = Array[ExtResource("1_283k2")]([SubResource("Resource_ct3wx"), SubResource("Resource_ak7je")])
