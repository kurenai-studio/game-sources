text = "The Law"

[sub_resource type="Resource" id="Resource_ewhws"]
script = ExtResource("2_n1tkv")
text = "The code was adapted line by line, and a good many lines were crossed out with a flourish, and the town found it liked its own handwriting."

[sub_resource type="Resource" id="Resource_uurv4"]
