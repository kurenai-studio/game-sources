# Local configuration. `make env` copies this to .env (git-ignored) and fills in a randomly
# generated local database password, so no password is ever stored in the repository.
# Nothing here is a real secret.

# --- Local database (Docker Compose) ---
POSTGRES_USER=algomind
POSTGRES_DB=algomind
POSTGRES_PASSWORD=
# Read by the API and by Prisma on the host. `make env` builds it from the values above.
DATABASE_URL=

# --- API (apps/api) ---
# CORS_ORIGINS=http://localhost:3000
# Signs access tokens (HS256). `make env` generates one; production needs at least 32 characters.
JWT_ACCESS_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# The first admin, created on startup when no admin exists (the first sign-in forces a new
# password). `make env` generates the password. Production refuses to start without both
# while no admin exists; the password needs at least 12 characters.
SUPER_ADMIN_EMAIL=admin@algomind.test
SUPER_ADMIN_PASS=
# Create the starter campaign (4 worlds, 5 chapters, 19 published levels, a client-registry row) on API
# startup when missing. Unset: always outside production, and in production only while the
# database has no levels. "true" always adds what is missing; "false" never creates them.
# SEED_STARTER_CAMPAIGN=true
# Reverse proxies in front of the API (1 on Render) so rate limits see the real client IP.
# TRUST_PROXY=0
# Make the API tell the web app to refresh its public pages after a publish (both are needed; the
# secret must match the web app's REVALIDATE_SECRET, at least 16 characters):
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

# Contact details the public contact page starts with (used once, while none are stored; after that
# the dashboard's Contact page edits them). All optional: a line with no value is not shown.
# CONTACT_NAME=
# CONTACT_EMAIL=
# CONTACT_GITHUB=https://github.com/<user>
# CONTACT_WEBSITE=
# CONTACT_ISSUES=https://github.com/<user>/<repo>/issues
# REVALIDATE_SECRET=

# --- Web (apps/web) ---
# API_BASE_URL=http://localhost:8000/v1
# Must equal the API's REVALIDATE_SECRET; enables POST /api/revalidate (off when unset):
# REVALIDATE_SECRET=
# Public origin for the sitemap and metadata (defaults to the live site; set it for a custom domain):
# SITE_URL=https://playalgomind.vercel.app
# GitHub Releases source for the download page (defaults shown). The token is optional and server-side only;
# anonymous visitors still cannot download assets from a private repository.
# GITHUB_REPOSITORY=shahadathhs/Algomind
# GITHUB_TOKEN=
# Only for testing or GitHub Enterprise; leave unset to use api.github.com:
# GITHUB_API_URL=https://api.github.com
